#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Isilinganiso Sezibalo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Ibuyisela inani elimaphakathi lawo wonke amanani alinganisiwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "akukho"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Inani Eliphezulu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Ibuyisela inani eliphakeme kakhulu elilinganisiwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Inani Eliphansi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Ibuyisela inani eliphansi kakhulu elilinganisiwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Isamba"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Ibuyisela isamba sawo wonke amanani alinganisiwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Inani Lamanani (Okungewona ama-NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Ibuyisela inani lamanani avumelekile alinganisiwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Umthambeka"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Ibuyisela umthambeka womugqa oqondile ngokusebenzisa i-linear regression nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Inani Lokugcina"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Ibuyisela inani lokugcina elivumelekile elilinganisiwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Inani Lokuqala"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Ibuyisela inani lokuqala elivumelekile elilinganisiwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Inani lama-NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Ibuyisela inani lama-NaN agcinwe nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Inani Eliphakathi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Ibuyisela lelo nani elihlukanisa ingxenye ephezulu engxenyeni ephansi nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Ibanga"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Ibuyisela umehluko phakathi kwenani elikhulu kakhulu nelincane kakhulu nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Ibanga Le-Interquartile"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Ibuyisela ibanga le-50&#037; eliphakathi nendawo elizungeze i-median nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Ukuchezuka Okujwayelekile"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Ibuyisela i-square root ngokwehlukahluka komthombo wedatha ngayinye"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Ukuhluka"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Ibuyisela ukwehlukahluka nge-DS ngayinye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Iphesentayili le-X"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Ibuyisela i-percentile yesi-x."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: umkhawulo ngamaphesenti. Ibanga: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Isikhathi Ngaphezu Komkhawulo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Ibuyisela isikhathi esingaphezu komkhawulo ochaziwe ngamaphesenti."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: umkhawulo (oqondile)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Isamba Ngaphezu Komkhawulo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Ibuyisela isamba samanani angaphezu komkhawulo ochaziwe."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Sondeza Izingxenyana Phansi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Ibuyisela inani elilandelayo eliphansi lenombolo ephelele ngokugudlulela phansi uma kudingeka."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: inombolo enamadesimali"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Sondeza Izingxenyana Phezulu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Ibuyisela inani elilandelayo eliphakeme lenombolo ephelele ngokugudlulela phezulu uma kudingeka."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Sondeza Inombolo Enedesimali"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Ibuyisela inani lenombolo ephelele elisondeziwe lanoma iyiphi inombolo enamadesimali enikeziwe."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: inombolo enamadesimali noma inani lochungechunge"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Thola Inani Eliphezulu Kakhulu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Ibuyisela inani eliphakeme kakhulu ohlwini olunikeziwe lwamapharamitha"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: amanani okufanele aqhathaniswe"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Thola Inani Eliphansi Kakhulu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Ibuyisela inani eliphansi kakhulu ohlwini olunikeziwe lwamapharamitha"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Ukusebenza Okunemibandela - Umqondo we-IF-THEN-ELSE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Ibuyisela u-B uma u-A eyiqiniso noma u-C uma u-A engamanga"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Thola ukuthi inani akusilo yini inombolo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Ibuyisela u-1 (noma u-B) uma u-A === NaN noma u-0 (noma u-C) uma kungenjalo. Amapharamitha u-B no-C ayazikhethela."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Ukuqhathanisa Okuyinkimbinkimbi"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Elinye igama le-f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Elinye igama le-f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Elinye igama le-f_cmp - KUYALINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (noma u-C) uma u-A == B noma u-0 (noma u-D) uma kungenjalo. Amapharamitha u-C no-D ayazikhethela."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Elinye igama le-f_cmp - AKULINGANI"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (noma u-C) uma u-A != B noma u-0 (noma u-D) uma kungenjalo. Amapharamitha u-C no-D ayazikhethela."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Elinye igama le-f_cmp - KUKHULU KUNA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (noma u-C) uma u-A > B noma u-0 (noma u-D) uma kungenjalo. Amapharamitha u-C no-D ayazikhethela."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Elinye igama le-f_cmp - KUPHANSI KUNA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (noma u-C) uma u-A < B noma u-0 (noma u-D) uma kungenjalo. Amapharamitha u-C no-D ayazikhethela."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Elinye igama le-f_cmp - KUKHULU NOMA KUYALINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (noma u-C) uma u-A >= B noma u-0 (noma u-D) uma kungenjalo. Amapharamitha u-C no-D ayazikhethela."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Elinye igama le-f_cmp - KUPHANSI NOMA KUYALINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (noma u-C) uma u-A <= B noma u-0 (noma u-D) uma kungenjalo. Amapharamitha u-C no-D ayazikhethela."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Ukwengeza"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Umsebenzi wezibalo wokubuyisa isamba samanani amabili noma ngaphezulu ahlanganiswayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Ukukhipha"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Umsebenzi wezibalo wokubuyisa umehluko phakathi kwenani okususwa kulo nenani elisuswayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Ukuphindaphinda"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Umsebenzi wezibalo wokubuyisa umphumela wokuphindaphinda inani eliphindaphindwayo nesiphindaphindi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Ukwahlukanisa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Umsebenzi wezibalo wokubuyisa ingxenyana yenani elihlukaniswayo nesihlukanisi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "I-Modulus"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Umsebenzi wezibalo wokubuyisa insalela yokuhlukaniswa kwezinombolo eziphelele ezimbili"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Ukuphindaphinda ngamandla - Kudingeka i-PHP5.6 noma ngaphezulu"

