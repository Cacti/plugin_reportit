#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Impuzandengo y'imibare"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Itanga impuzandengo y'ibipimo byose byafashwe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "nta na kimwe"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Agaciro ntarengwa ko hejuru"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Itanga agaciro ko hejuru kurusha utundi kapimwe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Agaciro ntarengwa ko hasi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Itanga agaciro ko hasi kurusha utundi kapimwe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Igiteranyo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Itanga igiteranyo cy'uduciro twose twapimwe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Umubare w'uduciro (Tutari NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Itanga umubare w'uduciro twemewe twapimwe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Ubuhaname"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Itanga ubutumburuke bw'umurongo ugororotse hakoreshejwe isesengura ry'umurongo kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Agaciro ka nyuma"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Itanga agaciro ka nyuma kemewe kapimwe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Agaciro ka mbere"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Itanga agaciro ka mbere kemewe kapimwe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Umubare wa NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Itanga umubare w'uduciro twa NaNs tubitswe kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Agaciro ko hagati"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Itanga agaciro gatandukanya igice cyo hejuru n'igice cyo hasi kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Intera"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Itanga ikinyuranyo hagati y'agaciro kanini kurusha utundi n'agaciro gato kurusha utundi kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Ikinyuranyo cy'ibice bya kane byo hagati"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Itanga intera ya 50&#037; yo hagati hafi y'agaciro ko hagati kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Ikinyuranyo shingiro"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Itanga umuzi wa kare w'itandukaniro kuri buri nkomoko y'amakuru"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Itandukaniro"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Itanga itandukaniro kuri buri DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Ijanisha rya X"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Itanga agaciro k'ijanisha rya x."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: urwego ntarengwa ku ijanisha. Igipimo: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Igihe hejuru y'urwego ntarengwa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Itanga igihe cyarenze urwego ntarengwa rwagenwe mu ijanisha."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: urwego ntarengwa (nyakuri)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Igiteranyo hejuru y'urwego ntarengwa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Itanga igiteranyo cy'uduciro turenze urwego ntarengwa rwagenwe."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Kumanura ibice hasi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Itanga umubare wuzuye wo hasi ukurikiyeho umanura agaciro bibaye ngombwa."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: umubare ufite ibice (float)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Kuzamura ibice hejuru"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Itanga umubare wuzuye wo hejuru ukurikiyeho uzamura agaciro bibaye ngombwa."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Kugorora umubare w'ibice"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Itanga umubare wuzuye wegeranyijwe w'umubare wose ufite ibice."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: agaciro k'umubare ufite ibice cyangwa inyuguti"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Shaka agaciro ko hejuru cyane"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Itanga agaciro ko hejuru kurusha utundi mu rutonde rw'ibipimo byatanzwe"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: uduciro tugomba kugereranywa"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Shaka agaciro ko hasi cyane"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Itanga agaciro ko hasi kurusha utundi mu rutonde rw'ibipimo byatanzwe"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Igikorwa kigengwa n'ibisabwa - Ikurikirana rya NIBA-UBWO-BITABA IBYO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Itanga B niba A ari ukuri cyangwa C niba A ari ikinyoma"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Reba niba agaciro atari umubare"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Itanga 1 (cyangwa B) niba A === NaN cyangwa 0 (cyangwa C) niba atari byo. Ibipimo B na C si itegeko."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Igereranya rihanitse"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Irindi zina rya f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Irindi zina rya f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Irindi zina rya f_cmp - BINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Itanga 1 (cyangwa C) niba A == B cyangwa 0 (cyangwa D) niba atari byo. Ibipimo C na D si itegeko."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Irindi zina rya f_cmp - BITANGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Itanga 1 (cyangwa C) niba A != B cyangwa 0 (cyangwa D) niba atari byo. Ibipimo C na D si itegeko."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Irindi zina rya f_cmp - BIRUTA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Itanga 1 (cyangwa C) niba A > B cyangwa 0 (cyangwa D) niba atari byo. Ibipimo C na D si itegeko."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Irindi zina rya f_cmp - BIRI HASI YA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Itanga 1 (cyangwa C) niba A < B cyangwa 0 (cyangwa D) niba atari byo. Ibipimo C na D si itegeko."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Irindi zina rya f_cmp - BIRUTA CYANGWA BINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Itanga 1 (cyangwa C) niba A >= B cyangwa 0 (cyangwa D) niba atari byo. Ibipimo C na D si itegeko."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Irindi zina rya f_cmp - BIRI HASI CYANGWA BINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Itanga 1 (cyangwa C) niba A <= B cyangwa 0 (cyangwa D) niba atari byo. Ibipimo C na D si itegeko."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Iyongera"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Igikorwa cy'imibare kigarura igiteranyo cy'imibare ibiri cyangwa irenga iteranywa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Gukuramo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Igikorwa cy'imibare kigarura ikinyuranyo hagati y'umubare ukubwamo n'ukurwamo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Gukuba"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Igikorwa cy'imibare kigarura igikubwa cy'umubare ukubwa n'ukuba"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Ishami"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Igikorwa cy'imibare kigarura umugabane w'umubare ugabanywa n'ugabanya"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Modulus"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Igikorwa cy'imibare kigarura ibisigaye mu kugabanya imibare ibiri yuzuye"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Gukuba inshuro nyinshi - PHP5.6 cyangwa hejuru yayo irakenewe"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Igikorwa cy'imibare kigarura ikuba (cyangwa igabanya) ryisubiramo ry'umubare fatizo ku cyuzuzo cy'ububasha bwawo."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Ikimenyetso k'ibice by'ikumi"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Ikimenyetso k'ibice by'ikumi gikoreshwa mu gutandukanya igice cyuzuye n'igice cy'imigabane"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Agakubo k'uruziga"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Bikoreshwa mu guhindura urutonde rusanzwe rw'ishyirwa mu bikorwa cyangwa kugaragaza urwego rwa mbere rw'ubugerekerane"

#: include/global_arrays.php
msgid "Square Bracket"
