#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Salan'isa aritmetika"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Mamerina ny sanda salanisa amin'ny sanda rehetra voarefy isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "tsy misy"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Sanda ambony indrindra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Mamerina ny sanda voarefy avo indrindra isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Sanda ambany indrindra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Mamerina ny sanda voarefy ambany indrindra isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Fitambarana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Mamerina ny fitambaran'ny sanda rehetra voarefy isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Isan'ny sanda (Tsy NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Mamerina ny isan'ny sanda voarefy manankery isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Gradianta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Mamerina ny fihilanana amin'ny tsipika mahitsy amin'ny alalan'ny regresiona tsipika isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Sanda farany"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Mamerina ny sanda voarefy manankery farany isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Sanda voalohany"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Mamerina ny sanda voarefy manankery voalohany isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Isan'ny NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Mamerina ny isan'ny NaN voatahiry isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Mediana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Mamerina ny sanda manasaraka ny tapany ambony amin'ny tapany ambany isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Elanelana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Mamerina ny elanelana eo amin'ny sanda lehibe indrindra sy ny kely indrindra isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Elanelana interkartila"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Mamerina ny halaviran'ny 50&#037; afovoany manodidina ny mediano isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Fiviliana fenitra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Mamerina ny faka efamira amin'ny fahasamihafan'ny loharanon'angona"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Variansa"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Mamerina ny variansa isaky ny DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Persantily faha-X"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Mamerina ny persentila faha-x."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: fetra amin'ny isan-jato. Elanelana: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Faharetana mihoatra ny fetra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Mamerina ny faharetana mihoatra ny fetra voafaritra amin'ny isan-jato."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: fetra (tanteraka)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Fitambarana mihoatra ny fetra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Mamerina ny fitambaran'ny sanda mihoatra ny fetra voafaritra."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Manaboribory ampaha midina"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Mamerina ny isa feno ambany manaraka amin'ny fanodinana midina raha ilaina."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: isa misy faingo"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Manaboribory ampaha miakatra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Mamerina ny isa feno ambony manaraka amin'ny fanodinana miakatra raha ilaina."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Manaboribory isa misy faingo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Mamerina ny isa feno voahodina amin'ny isa misy faingo nomena."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: isa misy faingo na sanda lahatsoratra"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Mitady ny sanda ambony indrindra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Mamerina ny sanda avo indrindra amin'ny lisitry ny masontsivana nomena"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: sanda hampitahaina"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Mitady ny sanda ambany indrindra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Mamerina ny sanda ambany indrindra amin'ny lisitry ny masontsivana nomena"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Asa misy fepetra - Lojika RAHA-DIA-RAHA TSY IZANY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Mamerina B raha marina A na C raha diso A"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Mitady raha tsy isa ny sanda iray"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Mamerina 1 (na B) raha A === NaN na 0 (na C) raha tsy izany. Tsy voatery omena ny masontsivana B sy C."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Fampitahana sarotra"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Solon'anaran'ny f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Solon'anaran'ny f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Solon'anaran'ny f_cmp - MITOVY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Mamerina 1 (na C) raha A == B na 0 (na D) raha tsy izany. Tsy voatery omena ny masontsivana C sy D."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Solon'anaran'ny f_cmp - TSY MITOVY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Mamerina 1 (na C) raha A != B na 0 (na D) raha tsy izany. Tsy voatery omena ny masontsivana C sy D."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Solon'anaran'ny f_cmp - LEHIBE KOKOA NOHO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Mamerina 1 (na C) raha A > B na 0 (na D) raha tsy izany. Tsy voatery omena ny masontsivana C sy D."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Solon'anaran'ny f_cmp - KELY KOKOA NOHO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Mamerina 1 (na C) raha A < B na 0 (na D) raha tsy izany. Tsy voatery omena ny masontsivana C sy D."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Solon'anaran'ny f_cmp - LEHIBE KOKOA NA MITOVY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Mamerina 1 (na C) raha A >= B na 0 (na D) raha tsy izany. Tsy voatery omena ny masontsivana C sy D."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Solon'anaran'ny f_cmp - KELY KOKOA NA MITOVY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Mamerina 1 (na C) raha A <= B na 0 (na D) raha tsy izany. Tsy voatery omena ny masontsivana C sy D."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Fanampiny"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Asa matematika mamerina ny fitambaran'ny isa atambatra roa na mihoatra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Fanalana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Asa matematika mamerina ny elanelan'ny isa ahena sy ny isa manala"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Fampitomboana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Asa matematika mamerina ny vokatra avy amin'ny mpampitombo sy ny isa ampitomboina"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Fizarana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Asa matematika mamerina ny fizaran'ny isa zaraina sy ny mpizara"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Modulus"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Asa matematika mamerina ny sisa amin'ny fizarana isa feno roa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Fananganana ho hery - ilaina ny PHP5.6 na ambony kokoa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Asa matematika mamerina ny fampitomboana (na fizarana) miverimberina ny fototra amin'ny tondrony."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Mari-desimaly"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Mari-desimaly ampiasaina hanasarahana ny ampahany feno amin'ny ampahany desimaly"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Fonon-teny boribory"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Ampiasaina hanovana ny laharam-pahamehana mahazatra na hanamarihana ny ambaratonga voalohany amin'ny fampidirana anaty"

#: include/global_arrays.php
msgid "Square Bracket"
msgstr "Fonosana efamira"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the second level of nesting"
msgstr "Ampiasaina hanovana ny laharam-pahamehana mahazatra na hanamarihana ny ambaratonga faharoa amin'ny fampidirana anaty"

#: include/global_arrays.php
msgid "Punctuation mark"
msgstr "Mari-piatoana"

#: include/global_arrays.php
msgid "Used to separate arguments forwarded to a function"
msgstr "Ampiasaina hanavahana ireo mari-pamantarana alefa amin'ny asa iray"

#: include/global_arrays.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Ny sanda farany ambany amin'ny angona azo angonina."

