#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Середнє арифметичне"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Повертає середнє значення всіх виміряних величин для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "жоден"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Максимальне значення"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Повертає найбільше виміряне значення для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Мінімальне значення"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Повертає найменше виміряне значення для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Сума"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Повертає суму всіх виміряних значень для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Кількість значень (не NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Повертає кількість коректних виміряних значень для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Градієнт"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Повертає нахил прямої за допомогою лінійної регресії для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Останнє значення"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Повертає останнє коректне виміряне значення для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Перше значення"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Повертає перше коректне виміряне значення для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Кількість значень NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Повертає кількість значень NaN, збережених для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Медіана"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Повертає значення, що розділяє верхню та нижню половини вибірки для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Розмах"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Повертає різницю між найбільшим і найменшим значеннями для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Міжквартильний розмах"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Повертає ширину середніх 50&#037; навколо медіани для кожного джерела даних"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Стандартне відхилення"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Повертає квадратний корінь дисперсії для кожного джерела даних"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Дисперсія"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Повертає дисперсію для кожного DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X-й процентиль"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Повертає x-й процентиль."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: поріг у відсотках. Діапазон: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Тривалість перевищення порогу"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Повертає тривалість перевищення визначеного порогу у відсотках."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: поріг (абсолютне значення)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Сума понад поріг"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Повертає суму значень, що перевищують визначений поріг."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Округлення дробових чисел униз"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Повертає найближче менше ціле значення, округлюючи вниз за потреби."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: число з рухомою комою (float)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Округлення дробових чисел угору"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Повертає найближче більше ціле значення, округлюючи вгору за потреби."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Округлення числа з рухомою комою"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Повертає округлене ціле значення будь-якого заданого числа з рухомою комою."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: число з рухомою комою або рядкове значення"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Пошук найбільшого значення"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Повертає найбільше значення із заданого списку параметрів"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: значення для порівняння"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Пошук найменшого значення"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Повертає найменше значення із заданого списку параметрів"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Умовна операція - логіка IF-THEN-ELSE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Повертає B, якщо A має значення true, або C, якщо A має значення false"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Перевірка, чи не є значення числом"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Повертає 1 (або B), якщо A === NaN, або 0 (або C) в іншому разі. Параметри B та C є необов'язковими."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Складне порівняння"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Псевдонім f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Псевдонім для f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Псевдонім f_cmp - ДОРІВНЮЄ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Повертає 1 (або C), якщо A == B, або 0 (або D) в іншому разі. Параметри C та D є необов'язковими."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Псевдонім для f_cmp - НЕ ДОРІВНЮЄ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Повертає 1 (або C), якщо A != B, або 0 (або D) в іншому разі. Параметри C та D є необов'язковими."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Псевдонім f_cmp - БІЛЬШЕ НІЖ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Повертає 1 (або C), якщо A > B, або 0 (або D) в іншому разі. Параметри C та D є необов'язковими."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Псевдонім f_cmp - МЕНШЕ НІЖ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Повертає 1 (або C), якщо A < B, або 0 (або D) в іншому разі. Параметри C та D є необов'язковими."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Псевдонім f_cmp - БІЛЬШЕ АБО ДОРІВНЮЄ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Повертає 1 (або C), якщо A >= B, або 0 (або D) в іншому разі. Параметри C та D є необов'язковими."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Псевдонім f_cmp - МЕНШЕ АБО ДОРІВНЮЄ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Повертає 1 (або C), якщо A <= B, або 0 (або D) в іншому разі. Параметри C та D є необов'язковими."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Додавання"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Математична операція для обчислення суми двох або більше доданків"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Віднімання"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Математична операція для обчислення різниці зменшуваного та від'ємника"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Множення"

#: include/global_arrays.php lib/const_measurands.php
