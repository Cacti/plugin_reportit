#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Matsakaicin Lissafi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Yana mayar da matsakaicin ƙimar dukkan ƙimomin da aka auna a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "babu"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Mafi Girman Ƙima"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Yana mayar da ƙimar da aka auna mafi girma a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Mafi Ƙanƙantar Ƙima"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Yana mayar da ƙimar da aka auna mafi ƙanƙanta a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Jimla"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Yana mayar da jimillar dukkan ƙimomin da aka auna a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Yawan Ƙimomi (Ba NaN ba)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Yana mayar da adadin ƙimomin da aka auna masu inganci a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Gangara"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Yana mayar da gangarar layi madaidaici ta hanyar amfani da koma-baya na layi a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Ƙimar Ƙarshe"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Yana mayar da ƙimar da aka auna ta ƙarshe mai inganci a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Ƙimar Farko"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Yana mayar da ƙimar da aka auna ta farko mai inganci a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Yawan NaNs"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Yana mayar da adadin NaN da aka adana a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Matsakaici"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Yana mayar da ƙimar da ke raba rabin sama da rabin ƙasa a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Kewayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Yana mayar da bambancin da ke tsakanin mafi girma da mafi ƙanƙantar ƙima a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Kewayon Tsakanin Kwata"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Yana mayar da tazarar tsakiyar 50&#037; kewaye da matsakaicin tsakiya a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Karkacewar Ma'auni"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Yana mayar da tushen murabba'i na bambancin kowane tushen bayanai"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Bambanci"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Yana mayar da bambancin ƙima a kowane DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Kashi na X"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Yana mayar da kashi na x cikin ɗari."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: iyaka a cikin kashi. Zango: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Tsawon Lokaci Akan Iyaka"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Yana mayar da tsawon lokaci da ya wuce iyaka da aka ayyana a cikin kashi cikin ɗari."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: iyaka (cikakke)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Jimla Akan Iyaka"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Yana mayar da jimillar ƙimomin da suka wuce iyaka da aka ayyana."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Zagaye Ragowar Lambobi Ƙasa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Yana mayar da lamba cikakkiya mafi ƙanƙanta ta gaba ta hanyar rage ƙima zuwa ƙasa idan ya zama dole."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: lamba mai maki (float)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Zagaye Ragowar Lambobi Sama"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Yana mayar da lamba cikakkiya mafi girma ta gaba ta hanyar cike ƙima zuwa sama idan ya zama dole."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Zagaye Lambar Desimal"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Yana mayar da lamba cikakkiya da aka cike ta kowace lamba mai ɗigo da aka bayar."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: lamba mai maki ko ƙimar rubutu"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Nemi Mafi Girman Ƙima"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Yana mayar da ƙima mafi girma daga jerin sigogin da aka bayar"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: ƙimomin da za a kwatanta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Nemi Mafi Ƙanƙantar Ƙima"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Yana mayar da ƙima mafi ƙanƙanta daga jerin sigogin da aka bayar"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Aikin Sharaɗi - Dabarar IDAN-TO-IN BA HAKA BA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Yana mayar da B idan A gaskiya ne ko C idan A ƙarya ne"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Nemi ko ƙima ba lamba ba ce"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Yana mayar da 1 (ko B) idan A === NaN ko 0 (ko C) idan ba haka ba. Sigogin B da C na zaɓi ne."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Kwatanta Mai Sarkakiya"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Sunan wani na f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Sunan wani na f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Sunan wani na f_cmp - YANA DAIDAI"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Yana mayar da 1 (ko C) idan A == B ko 0 (ko D) idan ba haka ba. Sigogin C da D na zaɓi ne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Sunan wani na f_cmp - BA YA DAIDAI"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Yana mayar da 1 (ko C) idan A != B ko 0 (ko D) idan ba haka ba. Sigogin C da D na zaɓi ne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Sunan wani na f_cmp - YA FI"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Yana mayar da 1 (ko C) idan A > B ko 0 (ko D) idan ba haka ba. Sigogin C da D na zaɓi ne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Sunan wani na f_cmp - YA KASA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Yana mayar da 1 (ko C) idan A < B ko 0 (ko D) idan ba haka ba. Sigogin C da D na zaɓi ne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Sunan wani na f_cmp - YA FI KO YANA DAIDAI"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Yana mayar da 1 (ko C) idan A >= B ko 0 (ko D) idan ba haka ba. Sigogin C da D na zaɓi ne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Sunan wani na f_cmp - YA KASA KO YANA DAIDAI"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Yana mayar da 1 (ko C) idan A <= B ko 0 (ko D) idan ba haka ba. Sigogin C da D na zaɓi ne."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Ƙari"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Aikin Lissafi don dawo da jimillar lambobin da ake tarawa guda biyu ko fiye"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Ragewa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Aikin Lissafi don dawo da bambancin adadin da ake ragewa da mai ragewa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Ninkawa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Aikin Lissafi don dawo da sakamakon ninkawar mai ninkawa da abin da ake ninkawa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Sashe"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Aikin Lissafi don dawo da rabon adadin da ake rabawa da mai rabawa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Modulus"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Aikin Lissafi don dawo da ragowar rabon lambobi guda biyu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Ƙara ƙarfi (Exponentiation) - Ana buƙatar PHP5.6 ko sama da haka"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Aikin Lissafi don dawo da ninkawa (ko rabo) akai-akai na tushen lamba ta hanyar ƙarfinta."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Alamar Goma"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Alamar Goma da ake amfani da ita wajen raba cikakken lamba da ɓangaren kashi"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Baka mai Zagaye"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Ana amfani da shi don soke fifikon yau da kullun ko don yi wa matakin farko na sakawa alama"

#: include/global_arrays.php
msgid "Square Bracket"
msgstr "Bakan Murabba'i"

