msgid "f_avg - Arithmetic Average"
msgstr "f_avg - अंकगणितीय औसत"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "सभी मापित मानों का औसत मान प्रति DS देता है"

#: include/global_arrays.php lib/const_measurands.php
#, fuzzy
msgid "none"
msgstr "कुछ भी नहीं"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - अधिकतम मूल्य"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "प्रति DS उच्चतम मापा मान देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - न्यूनतम मूल्य"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "प्रति DS सबसे कम मापा मान देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - योग"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "प्रति DS सभी मापित मानों का योग देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - मानों की संख्या (NaN नहीं)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "प्रति DS मान्य मापे गए मानों की संख्या देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - ढाल"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "प्रति DS रैखिक प्रतिगमन का उपयोग करके एक सीधी रेखा का ग्रेडिएंट देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - अंतिम मान"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "अंतिम मान्य मापा मान प्रति DS देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - प्रथम मान"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "प्रति DS पहला मान्य मापा मान देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - एनएएनएस की संख्या"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "प्रति DS संग्रहीत NaNs की संख्या देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - माध्यिका"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "वह मान लौटाता है जो उच्च आधे को प्रति DS निचले आधे से अलग करता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - रेंज"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "प्रति DS सबसे बड़े और सबसे छोटे मान के बीच का अंतर देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - इंटरक्वार्टाइल रेंज"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "मध्य की दूरी50% प्रति DS माध्यिका के आसपास देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - मानक विचलन"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "प्रति डेटा स्रोत प्रसरण वर्गमूल देता है"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - प्रसरण"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "प्रति DS प्रसरण देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - दसवीं प्रतिशतक"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "दसवाँ पर्सेंटाइल देता है."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: प्रतिशत में दहलीज। रेंज: [0&lt; $var ≤100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - थ्रेसहोल्ड से अधिक अवधि"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "निर्धारित सीमा से अधिक अवधि को प्रतिशत में लौटाता है."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: थ्रेशोल्ड (निरपेक्ष)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - थ्रेशोल्ड से अधिक राशि"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "निर्धारित सीमा पर मानों का योग देता है."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - गोल अंश नीचे"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "यदि आवश्यक हो तो मान को पूर्णांक बनाकर अगला सबसे कम पूर्णांक मान देता है."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: फ्लोट"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - गोल अंश ऊपर"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "यदि आवश्यक हो तो मान को पूर्णांक बनाकर अगला उच्चतम पूर्णांक मान देता है."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - राउंड ए फ्लोट"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "किसी भी दिए गए फ्लोट का पूर्णांक मान देता है."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: फ्लोट या स्ट्रिंग मान"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - उच्चतम मूल्य खोजें"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "पैरामीटर्स की दी गई सूची का उच्चतम मान देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var 1, $var 2, $var 3 ...: तुलना किए जाने वाले मान"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - न्यूनतम मान ज्ञात कीजिए"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "पैरामीटर्स की दी गई सूची का सबसे कम मान देता है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - सशर्त ऑपरेशन - IF-THEN-ELSE LOGIC"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "B देता है यदि A सत्य है या C यदि A असत्य है"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - पता लगाएँ कि क्या मान कोई संख्या नहीं है"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "1 (या बी) देता है यदि ए === एनएएन या 0 (या सी) यदि नहीं। पैरामीटर बी और सी वैकल्पिक हैं।"

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - जटिल तुलना"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - f_floor का उपनाम"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - f_round का उपनाम"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - f_cmp का उपनाम - बराबर है"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "1 (या C) देता है यदि A == B या 0 (या D) यदि नहीं। पैरामीटर C और D वैकल्पिक हैं।"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - f_cmp का उपनाम - असमान है"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "1 (या C) देता है यदि A!= B या 0 (या D) यदि नहीं। पैरामीटर C और D वैकल्पिक हैं।"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - f_cmp का उपनाम - इससे बड़ा है"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "यदि A, B > या 0 (या D) देता है, यदि नहीं, तो 1 (या C) देता है। पैरामीटर C और D वैकल्पिक हैं."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - f_cmp का उपनाम - इससे कम है"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "यदि A, B < या 0 (या D) देता है, यदि नहीं, तो 1 (या C) देता है। पैरामीटर C और D वैकल्पिक हैं."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - f_cmp का उपनाम - बड़ा या बराबर है"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
