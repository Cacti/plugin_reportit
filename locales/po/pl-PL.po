#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Średnia arytmetyczna"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Zwraca średnią wartość wszystkich zmierzonych wartości na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "brak"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Wartość maksymalna"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Zwraca najwyższą zmierzoną wartość na DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Wartość minimalna"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Zwraca najniższą zmierzoną wartość na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Suma"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Zwraca sumę wszystkich zmierzonych wartości na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - liczba wartości (nie NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Zwraca liczbę prawidłowych zmierzonych wartości na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Gradient"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Zwraca nachylenie linii prostej przy użyciu regresji liniowej na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Ostatnia wartość"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Zwraca ostatnią prawidłową wartość zmierzoną na DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Pierwsza wartość"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Zwraca pierwszą prawidłową zmierzoną wartość na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - liczba NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Zwraca liczbę wartości NaN przechowywanych na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Mediana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Zwraca wartość, która oddziela górną połowę od dolnej połowy na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Zasięg"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Zwraca różnicę między największą i najmniejszą wartością na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Rozstęp międzykwartylowy"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Zwraca odległość od środka 50% wokół mediany na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Odchylenie standardowe"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Zwraca pierwiastek kwadratowy na wariancję źródła danych."

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Wariancja"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Zwraca wariancję na DS."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X-ty percentyl"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Zwraca x-ty procent."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: próg w procentach. Zakres: [0&lt; $var ≤100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Przekroczenie progu czasu trwania"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Zwraca czas trwania po przekroczeniu zdefiniowanego progu w procentach."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: próg (bezwzględny)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Suma powyżej progu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Zwraca sumę wartości powyżej zdefiniowanego progu."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Zaokrąglanie ułamków w dół"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Zwraca następną najniższą wartość całkowitą, zaokrąglając wartość w dół, jeśli to konieczne."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: pływak"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Zaokrąglanie ułamków w górę"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Zwraca następną najwyższą wartość całkowitą, zaokrąglając wartość w górę, jeśli to konieczne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Runda A Spławik"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Zwraca zaokrągloną wartość całkowitą dowolnej liczby zmiennoprzecinkowej."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: wartość zmiennoprzecinkowa lub ciągowa"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Znajdź najwyższą wartość"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Zwraca najwyższą wartość z podanej listy parametrów"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var 1, $var 2, $var 3 ...: wartości do porównania"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Znajdź najniższą wartość"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Zwraca najniższą wartość z danej listy parametrów"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Operacja warunkowa - Logika IF-THEN-ELSE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Zwraca wartość B, jeśli wartość A jest prawdziwa, lub C, jeśli wartość A jest fałszywa."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Sprawdź, czy wartość nie jest liczbą"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Zwraca 1 (lub B), jeśli A === NaN lub 0 (lub C), jeśli nie. Parametry B i C są opcjonalne."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Złożone porównanie"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - alias f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - alias f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - alias od f_cmp - JEST RÓWNY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Zwraca 1 (lub C), jeśli A == B lub 0 (lub D), jeśli nie. Parametry C i D są opcjonalne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - alias od f_cmp - JEST NIERÓWNY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Zwraca wartość 1 (lub C), jeśli A != B lub 0 (lub D), jeśli nie. Parametry C i D są opcjonalne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt — alias liczby f_cmp — JEST WIĘKSZA NIŻ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Zwraca wartość 1 (lub C), jeśli A > B lub 0 (lub D), jeśli nie. Parametry C i D są opcjonalne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt — alias liczby f_cmp — JEST NIŻSZY NIŻ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Zwraca wartość 1 (lub C), jeśli A < B lub 0 (lub D), jeśli nie. Parametry C i D są opcjonalne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge — alias od f_cmp — JEST WIĘKSZY LUB RÓWNY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Zwraca 1 (lub C), jeśli A > = B lub 0 (lub D), jeśli nie. Parametry C i D są opcjonalne."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le — alias liczby f_cmp — JEST MNIEJSZY LUB RÓWNY"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Zwraca 1 (lub C), jeśli A < = B lub 0 (lub D), jeśli nie. Parametry C i D są opcjonalne."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Dodawanie"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Operacja matematyczna zwracająca sumę dwóch lub więcej sum"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Odejmowanie"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Operacja matematyczna zwracająca różnicę między minuendem a odejmowaniem"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Mnożenie"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Operacja matematyczna zwracająca iloczyn mnożnika i multiplikanta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Dzielenie"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Operacja matematyczna zwracająca ułamek dzielnika i dzielnika"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Moduł"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Operacja matematyczna zwracająca resztę z dzielenia dwóch liczb całkowitych"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Potęgowanie - wymagane PHP5.6 lub nowsze"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Operacja matematyczna zwracająca wielokrotne mnożenie (lub dzielenie) podstawy przez jej wykładnik."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Znak dziesiętny"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Znak dziesiętny używany do oddzielania części całkowitej od części ułamkowej"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Nawias okrągły"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Służy do zastępowania normalnego pierwszeństwa lub oznaczania pierwszego poziomu zagnieżdżania"

#: include/global_arrays.php
msgid "Square Bracket"
msgstr "Nawias kwadratowy"

#: include/global_arrays.php lib/const_measurands.php
