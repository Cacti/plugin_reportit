#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Aritmetička sredina"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Vraća prosječnu vrijednost svih izmjerenih vrijednosti po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "nijedno"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Maksimalna vrijednost"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Vraća najveću izmjerenu vrijednost po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Minimalna vrijednost"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Vraća najmanju izmjerenu vrijednost po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Zbir"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Vraća zbir svih izmjerenih vrijednosti po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Broj vrijednosti (nije NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Vraća broj važećih izmjerenih vrijednosti po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Gradijent"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Vraća gradijent prave linije koristeći linearnu regresiju po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Posljednja vrijednost"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Vraća posljednju važeću izmjerenu vrijednost po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Prva vrijednost"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Vraća prvu važeću izmjerenu vrijednost po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Broj NaN vrijednosti"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Vraća broj NaN vrijednosti pohranjenih po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Medijan"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Vraća vrijednost koja razdvaja gornju polovinu od donje polovine po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Raspon"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Vraća razliku između najveće i najmanje vrijednosti po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Interkvartilni raspon"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Vraća udaljenost srednjih 50&#037; oko medijana po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Standardna devijacija"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Vraća kvadratni korijen varijanse po izvoru podataka"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Varijansa"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Vraća varijansu po DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X-ti percentil"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Vraća x-ti percentil."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: prag u procentima. Opseg: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Trajanje iznad praga"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Vraća trajanje iznad definisanog praga u procentima."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: prag (apsolutni)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Zbir iznad praga"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Vraća zbir vrijednosti iznad definisanog praga."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Zaokruži razlomke naniže"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Vraća sljedeću najmanju cjelobrojnu vrijednost zaokruživanjem vrijednosti naniže ako je potrebno."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: decimalni broj"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Zaokruži razlomke naviše"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Vraća sljedeću najveću cjelobrojnu vrijednost zaokruživanjem vrijednosti naviše ako je potrebno."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Zaokruži decimalni broj"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Vraća zaokruženu cjelobrojnu vrijednost bilo kojeg datog decimalnog broja."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: decimalni broj ili tekstualna vrijednost"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Pronađi najveću vrijednost"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Vraća najveću vrijednost iz date liste parametara"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: vrijednosti koje treba uporediti"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Pronađi najmanju vrijednost"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Vraća najmanju vrijednost iz date liste parametara"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Uslovna operacija - IF-THEN-ELSE logika"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Vraća B ako je A tačno ili C ako je A netačno"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Provjeri da li vrijednost nije broj"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Vraća 1 (ili B) ako je A === NaN ili 0 (ili C) ako nije. Parametri B i C su opcioni."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Složeno poređenje"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Alijas za f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Alijas za f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Alijas za f_cmp - JEDNAKO JE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Vraća 1 (ili C) ako je A == B ili 0 (ili D) ako nije. Parametri C i D su opcioni."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Alijas za f_cmp - NIJE JEDNAKO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Vraća 1 (ili C) ako je A != B ili 0 (ili D) ako nije. Parametri C i D su opcioni."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Alijas za f_cmp - VEĆE JE OD"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Vraća 1 (ili C) ako je A > B ili 0 (ili D) ako nije. Parametri C i D su opcioni."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Alijas za f_cmp - MANJE JE OD"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Vraća 1 (ili C) ako je A < B ili 0 (ili D) ako nije. Parametri C i D su opcioni."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Alijas za f_cmp - VEĆE ILI JEDNAKO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Vraća 1 (ili C) ako je A >= B ili 0 (ili D) ako nije. Parametri C i D su opcioni."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Alijas za f_cmp - MANJE ILI JEDNAKO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Vraća 1 (ili C) ako je A <= B ili 0 (ili D) ako nije. Parametri C i D su opcioni."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Sabiranje"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Matematička operacija za vraćanje zbira dva ili više sabiraka"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Oduzimanje"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Matematička operacija za vraćanje razlike umanjenika i umanjioca"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Množenje"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Matematička operacija za vraćanje proizvoda množioca i množenika"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Dijeljenje"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Matematička operacija za vraćanje količnika djeljenika i djelioca"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Modulo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Matematička operacija za vraćanje ostatka dijeljenja dva cijela broja"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Stepenovanje - potreban je PHP5.6 ili noviji"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Matematička operacija za vraćanje ponovljenog množenja (ili dijeljenja) baze njenim eksponentom."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Decimalna oznaka"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Decimalna oznaka koja se koristi za odvajanje cjelobrojnog dijela od razlomljenog dijela"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Obla zagrada"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Koristi se za izmjenu uobičajenog prioriteta ili za označavanje prvog nivoa ugnježđivanja"

#: include/global_arrays.php
msgid "Square Bracket"
msgstr "Uglasta zagrada"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the second level of nesting"
msgstr "Koristi se za poništavanje uobičajenog prioriteta ili za označavanje drugog nivoa ugnježđivanja"

#: include/global_arrays.php
msgid "Punctuation mark"
msgstr "Interpunkcijski znak"

#: include/global_arrays.php
msgid "Used to separate arguments forwarded to a function"
msgstr "Koristi se za razdvajanje argumenata proslijeđenih funkciji"

#: include/global_arrays.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Minimalna vrijednost podataka koju je dozvoljeno prikupljati."

#: include/global_arrays.php
msgid "WARNING! This variable can be set to zero or unlimited"
