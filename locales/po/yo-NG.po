#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Àròpọ̀ Pínpín Ìṣirò"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Ń dá iye ìpíndọ́gba gbogbo àwọn iye tí a wọ̀n padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "kò sí"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Iye Tó Pọ̀ Jùlọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Ń dá iye tó ga jù lọ tí a wọ̀n padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Iye Tó Kéré Jùlọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Ń dá iye tó kéré jù lọ tí a wọ̀n padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Àròpọ̀"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Ń dá àròpọ̀ gbogbo àwọn iye tí a wọ̀n padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Iye Àwọn Iye (Kì í ṣe NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Ń dá iye àwọn iye tó wúlò tí a wọ̀n padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Ìtẹ̀sí"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Ń dá ìtẹ̀sí ìlà tààrà padà nípa lílo ìṣirò ìtẹ̀sí oníìlà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Iye Ìkẹyìn"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Ń dá iye ìkẹyìn tí ó wúlò tí a wọ̀n padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Iye Àkọ́kọ́"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Ń dá iye àkọ́kọ́ tí ó wúlò tí a wọ̀n padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Iye Àwọn NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Ń dá iye àwọn NaN tí a tọ́jú padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Àárín"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Ń dá iye tó pín ìdajì òkè kúrò lára ìdajì ìsàlẹ̀ padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Ààlà Iye"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Ń dá ìyàtọ̀ láàárín iye tó tóbi jù lọ àti iye tó kéré jù lọ padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Àlààárín Ìdá Mẹ́rin"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Ń dá ìjìnnà 50&#037; àárín yíká ìlà àárín padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Ìyàtọ̀ Ìwọ̀n"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Ń dá gbòǹgbò onígun mẹ́rin fún ìyàtọ̀ orísun dátà kọ̀ọ̀kan padà"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Ìyàtọ̀"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Ń dá ìyàtọ̀ padà fún DS kọ̀ọ̀kan"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Ìdá Ọgọ́rùn-ún Xth"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Ń dá ìpín ọgọ́rùn-ún kẹ-x padà."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: àlà ní ìdá ọgọ́rùn-ún. Ààlà: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Àkókò Lórí Àlà"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Ń dá àkókò tó kọjá àlà tí a ṣàlàyé padà ní ìpín ọgọ́rùn-ún."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: àlà (pàtó)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Àròpọ̀ Lórí Àlà"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Ń dá àròpọ̀ àwọn iye tó kọjá àlà tí a ṣàlàyé padà."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Pa Ìdá Sílẹ̀"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Ń dá odidi nọ́ńbà tó kéré jù tẹ̀lé e padà nípa yíyí iye náà sílẹ̀ tí ó bá pọndandan."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: nọ́mbà onídẹ́símà"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Pa Ìdá Sókè"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Ń dá odidi nọ́ńbà tó ga jù tẹ̀lé e padà nípa yíyí iye náà sókè tí ó bá pọndandan."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Yí Nọ́ńbà Eléèpo Pọ̀"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Ń dá odidi nọ́ńbà tí a yí padà láti inú nọ́ńbà oní-fílóòtù èyíkéyìí padà."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: iye nọ́mbà onídẹ́símà tàbí okùn ọ̀rọ̀"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Wá Iye Tó Ga Jùlọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Ń dá iye tó ga jù lọ nínú àtòjọ àwọn pàrámítà tí a fúnni padà"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: àwọn iye tí a fẹ́ fi wé ara wọn"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Wá Iye Tó Kéré Jùlọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Ń dá iye tó kéré jù lọ nínú àtòjọ àwọn pàrámítà tí a fúnni padà"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Iṣẹ́ Aláṣẹ̀dá - Ìlànà IF-THEN-ELSE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Ń dá B padà tí A bá jẹ́ òótọ́ tàbí C tí A bá jẹ́ irọ́"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Wá bóyá iye kan kì í ṣe nọ́ńbà"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Ń dá 1 (tàbí B) padà tí A === NaN bá jẹ́ bẹ́ẹ̀ tàbí 0 (tàbí C) tí kò bá rí bẹ́ẹ̀. Àwọn pàrámítà B àti C jẹ́ àṣàyàn."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Ìfiwéra Dídíjú"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Orúkọ mìíràn fún f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Orúkọ mìíràn fún f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Orúkọ mìíràn fún f_cmp - DỌ́GBA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ń dá 1 (tàbí C) padà tí A == B bá jẹ́ bẹ́ẹ̀ tàbí 0 (tàbí D) tí kò bá rí bẹ́ẹ̀. Àwọn pàrámítà C àti D jẹ́ àṣàyàn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Orúkọ mìíràn fún f_cmp - KÒ DỌ́GBA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ń dá 1 (tàbí C) padà tí A != B bá jẹ́ bẹ́ẹ̀ tàbí 0 (tàbí D) tí kò bá rí bẹ́ẹ̀. Àwọn pàrámítà C àti D jẹ́ àṣàyàn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Orúkọ mìíràn fún f_cmp - PỌ̀ JÙ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ń dá 1 (tàbí C) padà tí A > B bá jẹ́ bẹ́ẹ̀ tàbí 0 (tàbí D) tí kò bá rí bẹ́ẹ̀. Àwọn pàrámítà C àti D jẹ́ àṣàyàn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Orúkọ mìíràn fún f_cmp - KÉRÉ JÙ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
