msgstr "Mathematische Operation, um den Rest einer Division von zwei ganzen Zahlen zurückzugeben"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Exponentiation - PHP5.6 oder höher erforderlich"

