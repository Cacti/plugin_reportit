#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Trung bình số học"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Trả về giá trị trung bình của tất cả các giá trị đo được trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "không"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Giá trị tối đa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Trả về giá trị đo cao nhất trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Giá trị tối thiểu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Trả về giá trị đo thấp nhất trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Tổng"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Trả về tổng của tất cả các giá trị đo được trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Số lượng giá trị (không phải NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Trả về số lượng giá trị đo hợp lệ trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Độ dốc"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Trả về gradient của một đường thẳng bằng cách dùng hồi quy tuyến tính trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Giá trị cuối cùng"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Trả về giá trị đo hợp lệ cuối cùng trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Giá trị đầu tiên"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Trả về giá trị đo hợp lệ đầu tiên trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Số lượng NaNs"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Trả về số NaN được lưu trữ trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Trung vị"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Trả về giá trị đó ngăn cách nửa trên với nửa dưới trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Phạm vi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Trả về hiệu giữa giá trị lớn nhất và nhỏ nhất trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Phạm vi liên phân vị"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Trả về khoảng cách của 50% giữa quanh trung vị trên mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Độ lệch chuẩn"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Trả về căn bậc hai cho mỗi phương sai nguồn dữ liệu"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Phương sai"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Trả về phương sai cho mỗi DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Phân vị thứ X"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Trả về phân vị thứ x."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: ngưỡng tính bằng phần trăm. Phạm vi: [0&lt; $var ≤100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Thời lượng vượt ngưỡng"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Trả về khoảng thời gian trên một ngưỡng xác định theo phần trăm."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: ngưỡng (tuyệt đối)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Tổng vượt ngưỡng"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Trả về tổng các giá trị trên một ngưỡng đã xác định."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Làm tròn phân số xuống"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Trả về giá trị số nguyên thấp nhất tiếp theo bằng cách làm tròn giá trị xuống nếu cần."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: phao"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Làm tròn phân số lên"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Trả về giá trị số nguyên cao nhất tiếp theo bằng cách làm tròn giá trị lên nếu cần."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Phao Vòng A"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Trả về giá trị số nguyên được làm tròn của bất kỳ số nổi đã cho nào."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: giá trị float hoặc chuỗi"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Tìm giá trị cao nhất"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Trả về giá trị cao nhất của một danh sách tham số đã cho"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var 1, $var 2, $var 3 ...: các giá trị cần so sánh"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Tìm giá trị thấp nhất"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Trả về giá trị thấp nhất của một danh sách tham số đã cho"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Hoạt động có điều kiện - Logic IF-THEN-ELSE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Trả về B nếu A đúng hoặc C nếu A sai"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Tìm xem một giá trị không phải là một số"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Trả về 1 (hoặc B) nếu A === NaN hoặc 0 (hoặc C) nếu không. Tham số B và C là tùy chọn."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - So sánh phức tạp"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Bí danh của f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Bí danh của f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Bí danh của f_cmp - BÌNH ĐẲNG"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Trả về 1 (hoặc C) nếu A == B hoặc 0 (hoặc D) nếu không. Tham số C và D là tùy chọn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Bí danh của f_cmp - LÀ KHÔNG BÌNH ĐẲNG"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Trả về 1 (hoặc C) nếu A != B hoặc 0 (hoặc D) nếu không. Tham số C và D là tùy chọn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Bí danh của f_cmp - LỚN HƠN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Trả về 1 (hoặc C) nếu A > B hoặc 0 (hoặc D) nếu không. Tham số C và D là tùy chọn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Bí danh của f_cmp - THẤP HƠN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Trả về 1 (hoặc C) nếu A < B hoặc 0 (hoặc D) nếu không. Tham số C và D là tùy chọn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Bí danh của f_cmp - LỚN HƠN HOẶC BẰNG NHAU"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Trả về 1 (hoặc C) nếu A >= B hoặc 0 (hoặc D) nếu không. Tham số C và D là tùy chọn."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Bí danh của f_cmp - THẤP HƠN HOẶC BẰNG NHAU"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Trả về 1 (hoặc C) nếu A <= B hoặc 0 (hoặc D) nếu không. Tham số C và D là tùy chọn."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Phép Cộng"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Phép toán để trả về tổng của hai hoặc nhiều tổng"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Phép trừ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Phép toán để trả về hiệu số của minuend và subtrahend"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Phép Nhân"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Phép toán trả về tích của số nhân và phép nhân"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Bộ môn"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Toán học Phép toán để trả về phần cổ tức và ước số"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Mô đun"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Toán học Phép toán để trả về phần còn lại của phép chia hai số nguyên"

