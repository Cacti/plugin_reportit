#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Nkezi Mgbakọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Na-eweghachi nkezi uru nke uru niile a tụrụ maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "ọ dịghị"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Uru Kachasị Ukwuu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Na-eweghachi uru kachasị elu a tụrụ maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Uru Kachasị Nta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Na-eweghachi uru kachasị ala a tụrụ maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Nchịkọta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Na-eweghachi ngụkọta nke uru niile a tụrụ maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Ọnụọgụgụ Uru (Ọ bụghị NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Na-eweghachi ọnụọgụ uru ziri ezi a tụrụ maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Mkpọda"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Na-eweghachi mkpọda nke ahịrị kwụ ọtọ site n'iji nlaghachi ahịrị maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Uru Ikpeazụ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Na-eweghachi uru ikpeazụ ziri ezi a tụrụ maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Uru Mbụ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Na-eweghachi uru izizi ziri ezi a tụrụ maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Ọnụọgụgụ NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Na-eweghachi ọnụọgụ NaNs echekwara maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Uru Etiti"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Na-eweghachi uru ahụ nke na-ekewa ọkara dị elu site na ọkara dị ala maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Oke Ọdịiche"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Na-eweghachi ọdịiche dị n'etiti uru kachasị ukwuu na nke kachasị nta maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Oke Nkeji Anọ Etiti"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Na-eweghachi anya nke etiti 50&#037; gburugburu etiti uru maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Nfechi Izugbe"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Na-eweghachi mgbọrọgwụ skwea maka mgbanwe Isi Iyi Data nke ọ bụla"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Ọdịiche Nkesa"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Na-eweghachi mgbanwe maka DS nke ọ bụla"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Pasentị nke X"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Na-eweghachi pasentaịl nke x."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: ọnụ ụzọ na pasentị. Oke: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Ogologo Oge Karịrị Ọnụ ụzọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Na-eweghachi ogologo oge karịrị ọnụ ụzọ akọwapụtara na pasentị."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: ọnụ ụzọ (zuru oke)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Nchịkọta Karịrị Ọnụ ụzọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Na-eweghachi ngụkọta nke uru karịrị ọnụ ụzọ akọwapụtara."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Gbaa Mpekere Ala"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Na-eweghachi ọnụọgụ zuru oke kachasị ala na-esote site n'ịgbadata uru ma ọ bụrụ na ọ dị mkpa."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: ọnụọgụgụ desimal"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Gbaa Mpekere Elu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Na-eweghachi ọnụọgụ zuru oke kachasị elu na-esote site n'ịgbagote uru ma ọ bụrụ na ọ dị mkpa."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Gbaa Ọnụọgụgụ Ntụpọ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Na-eweghachi ọnụọgụ zuru oke a gbagoro gburugburu nke ọnụọgụ ntụpọ ọ bụla e nyere."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: ọnụọgụgụ desimal ma ọ bụ eriri okwu"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Chọta Uru Kachasị Elu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Na-eweghachi uru kachasị elu nke ndepụta paramita e nyere"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: ọnụọgụgụ a ga-atụnyere"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Chọta Uru Kachasị Ala"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Na-eweghachi uru kachasị ala nke ndepụta paramita e nyere"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Ọrụ Nke Nwere Ọnọdụ - Echiche Ọ BỤRỤ-MGBE AHỤ-MA Ọ BỤGHỊ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Na-eweghachi B ma ọ bụrụ na A bụ eziokwu ma ọ bụ C ma ọ bụrụ na A bụ ụgha"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Chọpụta ma uru ọ bụghị ọnụọgụgụ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Na-eweghachi 1 (ma ọ bụ B) ma ọ bụrụ na A === NaN ma ọ bụ 0 (ma ọ bụ C) ma ọ bụghị ya. Paramita B na C bụ nhọrọ."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Ntụnyere Mgbagwoju Anya"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Aha ọzọ nke f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Aha ọzọ nke f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Aha ọzọ nke f_cmp - HA NHATA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Na-eweghachi 1 (ma ọ bụ C) ma ọ bụrụ na A == B ma ọ bụ 0 (ma ọ bụ D) ma ọ bụghị ya. Paramita C na D bụ nhọrọ."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Aha ọzọ nke f_cmp - AHAGHỊ NHATA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Na-eweghachi 1 (ma ọ bụ C) ma ọ bụrụ na A != B ma ọ bụ 0 (ma ọ bụ D) ma ọ bụghị ya. Paramita C na D bụ nhọrọ."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Aha ọzọ nke f_cmp - KARỊRỊ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Na-eweghachi 1 (ma ọ bụ C) ma ọ bụrụ na A > B ma ọ bụ 0 (ma ọ bụ D) ma ọ bụghị ya. Paramita C na D bụ nhọrọ."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Aha ọzọ nke f_cmp - DỊ ALA KARỊ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Na-eweghachi 1 (ma ọ bụ C) ma ọ bụrụ na A < B ma ọ bụ 0 (ma ọ bụ D) ma ọ bụghị ya. Paramita C na D bụ nhọrọ."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Aha ọzọ nke f_cmp - KARỊRỊ MA Ọ BỤ HA NHATA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Na-eweghachi 1 (ma ọ bụ C) ma ọ bụrụ na A >= B ma ọ bụ 0 (ma ọ bụ D) ma ọ bụghị ya. Paramita C na D bụ nhọrọ."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Aha ọzọ nke f_cmp - DỊ ALA KARỊ MA Ọ BỤ HA NHATA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Na-eweghachi 1 (ma ọ bụ C) ma ọ bụrụ na A <= B ma ọ bụ 0 (ma ọ bụ D) ma ọ bụghị ya. Paramita C na D bụ nhọrọ."

#: include/global_arrays.php lib/const_measurands.php
