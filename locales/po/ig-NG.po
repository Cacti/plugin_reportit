#: templates.php
msgid "The explanation given to this measurand. This will be shown as legend within exports as well as a tooltip within the presentation of a report itself."
msgstr "Nkọwa e nyere maka ihe a na-atụ atụ. A ga-egosi nke a dị ka akara nkọwa n'ime mbupụ nakwa dị ka ndụmọdụ ngwaọrụ n'ime ngosipụta nke mkpesa ahụ n'onwe ya."

#: templates.php
msgid "Define a unique abbreviation for this measurand with max. 8 letters/numbers."
msgstr "Kọwaa mkpirisi pụrụ iche maka ihe a na-atụ atụ nke nwere kacha mkpụrụedemede/ọnụọgụgụ 8."

#: templates.php
msgid "The unit given to this measurand. e.g. 'Bits/s'"
