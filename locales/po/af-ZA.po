#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Rekenkundige gemiddelde"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Gee die gemiddelde waarde van alle gemete waardes per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "geen"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Maksimumwaarde"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Gee die hoogste gemete waarde per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Minimumwaarde"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Gee die laagste gemete waarde per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Som"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Gee die som van alle gemete waardes per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Aantal waardes (nie NaN nie)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Gee die aantal geldige gemete waardes per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Gradiënt"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Gee die gradiënt van 'n reguit lyn terug deur lineêre regressie per DS te gebruik"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Laaste waarde"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Gee die laaste geldige gemete waarde per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Eerste waarde"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Gee die eerste geldige gemete waarde per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Aantal NaN-waardes"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Gee die aantal NaN-waardes wat per DS gestoor is terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Mediaan"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Gee die waarde terug wat die boonste helfte van die onderste helfte per DS skei"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Bereik"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Gee die verskil tussen die grootste en die kleinste waarde per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Interkwartielomvang"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Gee die afstand van die middelste 50&#037; rondom die mediaan per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Standaardafwyking"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Gee die vierkantswortel van die variansie per databron terug"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Variansie"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Gee die variansie per DS terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X-de persentiel"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Gee die x-de persentiel terug."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: drempel in persent. Reeks: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Duur oor drempel"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Gee die duur bo 'n gedefinieerde drempel in persent terug."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: drempel (absoluut)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Som oor drempel"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Gee die som van waardes bo 'n gedefinieerde drempel terug."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Rond breuke af"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Gee die volgende laagste heelgetalwaarde terug deur die waarde af te rond indien nodig."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: dryfpuntgetal"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Rond breuke op"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Gee die volgende hoogste heelgetalwaarde terug deur die waarde op te rond indien nodig."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Rond 'n dryfpuntgetal af"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Gee die afgeronde heelgetalwaarde van enige gegewe dryfpuntgetal terug."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: dryfpunt- of stringwaarde"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Vind hoogste waarde"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Gee die hoogste waarde van 'n gegewe lys parameters terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: waardes wat vergelyk moet word"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Vind laagste waarde"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Gee die laagste waarde van 'n gegewe lys parameters terug"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Voorwaardelike bewerking - AS-DAN-ANDERS-logika"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Gee B terug as A waar is of C as A onwaar is"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Bepaal of 'n waarde nie 'n getal is nie"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Gee 1 (of B) terug as A === NaN of 0 (of C) indien nie. Parameters B en C is opsioneel."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Komplekse vergelyking"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Alias van f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Alias van f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Alias van f_cmp - IS GELYK"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Gee 1 (of C) terug as A == B of 0 (of D) indien nie. Parameters C en D is opsioneel."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Alias van f_cmp - IS ONGELYK"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Gee 1 (of C) terug as A != B of 0 (of D) indien nie. Parameters C en D is opsioneel."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Alias van f_cmp - IS GROTER AS"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Gee 1 (of C) terug as A > B of 0 (of D) indien nie. Parameters C en D is opsioneel."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Alias van f_cmp - IS LAER AS"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Gee 1 (of C) terug as A < B of 0 (of D) indien nie. Parameters C en D is opsioneel."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Alias van f_cmp - IS GROTER OF GELYK"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Gee 1 (of C) terug as A >= B of 0 (of D) indien nie. Parameters C en D is opsioneel."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Alias van f_cmp - IS LAER OF GELYK"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Gee 1 (of C) terug as A <= B of 0 (of D) indien nie. Parameters C en D is opsioneel."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Byvoeging"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Wiskundige bewerking om die som van twee of meer opteltalle terug te gee"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Aftrekking"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Wiskundige bewerking om die verskil tussen die aftrektal en die aftrekker terug te gee"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Vermenigvuldiging"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Wiskundige bewerking om die produk van die vermenigvuldiger en die vermenigvuldigtal terug te gee"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Afdeling"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Wiskundige bewerking om die breuk van die deeltal en die deler terug te gee"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Modulus"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Wiskundige bewerking om die res van 'n deling van twee heelgetalle terug te gee"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Magsverheffing - PHP5.6 of hoër vereis"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Wiskundige bewerking om die herhaalde vermenigvuldiging (of deling) van 'n grondtal met sy eksponent terug te gee."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Desimale teken"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Desimale teken wat gebruik word om die heelgetalgedeelte van die breukgedeelte te skei"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Ronde hakie"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Word gebruik om normale voorkeur te oorheers of om die eerste vlak van nesvorming te merk"

#: include/global_arrays.php
msgid "Square Bracket"
msgstr "Vierkantige hakie"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the second level of nesting"
msgstr "Word gebruik om normale voorkeur te oorheers of om die tweede vlak van nesvorming te merk"

#: include/global_arrays.php
msgid "Punctuation mark"
msgstr "Leesteken"

#: include/global_arrays.php
msgid "Used to separate arguments forwarded to a function"
msgstr "Word gebruik om argumente wat na 'n funksie aangestuur word te skei"

#: include/global_arrays.php
msgid "The minimum value of data that is allowed to be collected."
msgstr "Die minimum waarde van data wat toegelaat word om ingesamel te word."

#: include/global_arrays.php
msgid "WARNING! This variable can be set to zero or unlimited"
msgstr "WAARSKUWING! Hierdie veranderlike kan op nul of onbeperk gestel word"

#: include/global_arrays.php
msgid "The maximum value of data that is allowed to be collected."
msgstr "Die maksimum waarde van data wat toegelaat word om ingesamel te word."

#: include/global_arrays.php lib/const_measurands.php
msgid "Contains the number of seconds between two measured values."
msgstr "Bevat die aantal sekondes tussen twee gemete waardes."

