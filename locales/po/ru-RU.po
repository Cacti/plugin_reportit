#: include/global_arrays.php:209 lib/const_measurands.php:69
msgid "f_last - Last Value"
msgstr "f_last - Последнее значение"

#: include/global_arrays.php:210 lib/const_measurands.php:70
msgid "Returns the last valid measured value per DS"
msgstr "Возвращает последнее действительное измеренное значение для каждого DS"

#: include/global_arrays.php:216 lib/const_measurands.php:76
msgid "f_1st - First Value"
msgstr "f_1st - Первое значение"

#: include/global_arrays.php:217 lib/const_measurands.php:77
msgid "Returns the first valid measured value per DS"
msgstr "Возвращает первое действительное измеренное значение для каждого DS"

#: include/global_arrays.php:223 lib/const_measurands.php:83
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Количество NaN"

#: include/global_arrays.php:224 lib/const_measurands.php:84
msgid "Returns the number of NaNs stored per DS"
msgstr "Возвращает количество NaN, сохраненных на DS"

#: include/global_arrays.php:230 lib/const_measurands.php:90
msgid "f_median - Median"
msgstr "f_median - Медиана"

#: include/global_arrays.php:231 lib/const_measurands.php:91
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Возвращает значение, которое отделяет верхнюю половину от нижней половины на DS"

#: include/global_arrays.php:237 lib/const_measurands.php:104
msgid "f_range - Range"
msgstr "f_range - Диапазон"

#: include/global_arrays.php:238 lib/const_measurands.php:105
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Возвращает разницу между наибольшим и наименьшим значением для каждого DS"

#: include/global_arrays.php:244 lib/const_measurands.php:111
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Межквартильный диапазон"

#: include/global_arrays.php:245 lib/const_measurands.php:112
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Возвращает расстояние между средними 50% вокруг медианы на DS"

#: include/global_arrays.php:251 lib/const_measurands.php:118
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Стандартное отклонение"

#: include/global_arrays.php:252 lib/const_measurands.php:119
msgid "Returns the square root per data source variance"
msgstr "Возвращает дисперсию квадратного корня для каждого источника данных"

#: include/global_arrays.php:258
msgid "f_var - Variance"
msgstr "f_var - Дисперсия"

#: include/global_arrays.php:259
msgid "Returns the variance per DS"
msgstr "Возвращает отклонение для каждого DS"

#: include/global_arrays.php:267 lib/const_measurands.php:149
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X-й процентиль"

#: include/global_arrays.php:268 lib/const_measurands.php:150
msgid "Returns the xth percentitle."
msgstr "Возвращает x-й процентит."

#: include/global_arrays.php:269 lib/const_measurands.php:151
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: порог в процентах. Дальность: [0&lt; $var ≤100]"

#: include/global_arrays.php:275 lib/const_measurands.php:156
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Длительность превышения порогового значения"

#: include/global_arrays.php:276 lib/const_measurands.php:157
msgid "Returns the duration over a defined threshold in percent."
msgstr "Возвращает продолжительность превышения определенного порогового значения в процентах."

#: include/global_arrays.php:277 include/global_arrays.php:285
#: lib/const_measurands.php:158 lib/const_measurands.php:165
msgid "$var: threshold (absolute)"
msgstr "$var: порог (абсолютный)"

#: include/global_arrays.php:283 lib/const_measurands.php:163
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Сумма выше порога"

#: include/global_arrays.php:284 lib/const_measurands.php:164
msgid "Returns the sum of values over a defined threshold."
msgstr "Возвращает сумму значений за заданное пороговое значение."

#: include/global_arrays.php:291 lib/const_measurands.php:170
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Округляем дроби вниз"

#: include/global_arrays.php:292 include/global_arrays.php:358
#: lib/const_measurands.php:131 lib/const_measurands.php:171
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Возвращает следующее наименьшее целочисленное значение путем округления значения в меньшую сторону, если это необходимо."

#: include/global_arrays.php:293 include/global_arrays.php:301
#: include/global_arrays.php:359 lib/const_measurands.php:132
#: lib/const_measurands.php:172 lib/const_measurands.php:179
msgid "$var: float"
msgstr "$var: поплавок"

#: include/global_arrays.php:299 lib/const_measurands.php:177
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Округляйте дроби вверх"

#: include/global_arrays.php:300 lib/const_measurands.php:178
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Возвращает следующее по величине целочисленное значение путем округления значения в большую сторону, если это необходимо."

#: include/global_arrays.php:307 lib/const_measurands.php:184
msgid "f_round - Round A Float"
msgstr "f_round - Круглый поплавок"

#: include/global_arrays.php:308 include/global_arrays.php:366
#: lib/const_measurands.php:138 lib/const_measurands.php:185
msgid "Returns the rounded integer value of any given float."
msgstr "Возвращает округленное целочисленное значение любого заданного числа с плавающей точкой."

#: include/global_arrays.php:309 include/global_arrays.php:367
#: lib/const_measurands.php:139 lib/const_measurands.php:186
msgid "$var: float or string value"
msgstr "$var: float или строковое значение"

#: include/global_arrays.php:315 lib/const_measurands.php:191
msgid "f_high - Find Highest Value"
msgstr "f_high - Найдите наивысшую ценность"

#: include/global_arrays.php:316 lib/const_measurands.php:192
msgid "Returns the highest value of a given list of parameters"
msgstr "Возвращает наибольшее значение заданного списка параметров"

#: include/global_arrays.php:317 include/global_arrays.php:325
#: lib/const_measurands.php:193 lib/const_measurands.php:200
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var 1, $var 2, $var 3...: сравниваемые значения"

#: include/global_arrays.php:323 lib/const_measurands.php:198
msgid "f_high - Find Lowest Value"
msgstr "f_high - Найти наименьшее значение"

#: include/global_arrays.php:324 lib/const_measurands.php:199
msgid "Returns the lowest value of a given list of parameters"
msgstr "Возвращает наименьшее значение заданного списка параметров"

#: include/global_arrays.php:331 lib/const_measurands.php:205
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Условная операция - логика IF-THEN-ELSE"

#: include/global_arrays.php:332 lib/const_measurands.php:206
msgid "Returns B if A is true or C if A is false"
msgstr "Возвращает B, если A истинно, или C, если A ложно"

#: include/global_arrays.php:339 lib/const_measurands.php:212
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Определение того, не является ли значение числом"

#: include/global_arrays.php:340 include/global_arrays.php:348
#: lib/const_measurands.php:213
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Возвращает 1 (или B), если A === NaN или 0 (или C), если нет. Параметры B и C являются необязательными."

#: include/global_arrays.php:347
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Комплексное сравнение"

#: include/global_arrays.php:357 lib/const_measurands.php:130
msgid "f_int - Alias of f_floor"
msgstr "f_int - Псевдоним f_floor"

#: include/global_arrays.php:365 lib/const_measurands.php:137
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Псевдоним f_round"

#: include/global_arrays.php:373 lib/const_measurands.php:219
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Псевдоним f_cmp - РАВНО"

#: include/global_arrays.php:374 lib/const_measurands.php:220
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Возвращает 1 (или C), если A == B или 0 (или D), если нет. Параметры C и D являются необязательными."

#: include/global_arrays.php:381 lib/const_measurands.php:226
