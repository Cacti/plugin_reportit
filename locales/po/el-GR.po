#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Αριθμητικός μέσος όρος"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Επιστρέφει τη μέση τιμή. (άθροισμα των τιμών / αριθμός αξιών)"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "κανένα"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Μέγιστη τιμή"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Επιστρέφει την πρώτη τιμή μέτρησης"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Ελάχιστη τιμή"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Επιστρέφει την τελευταία τιμή που μετρήθηκε"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Άθροισμα"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Επιστρέφει την τελευταία τιμή που μετρήθηκε"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Αριθμός τιμών (Όχι NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Επιστρέφει τον αριθμό των τιμών"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Διαβάθμιση"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Επιστρέφει τη διαβάθμιση μιας ευθείας γραμμής χρησιμοποιώντας γραμμική παλινδρόμηση"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Τελευταία τιμή"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Επιστρέφει την τελευταία τιμή που μετρήθηκε"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Πρώτη τιμή"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Επιστρέφει την πρώτη τιμή μέτρησης"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Αριθμός NaNs"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Επιστρέφει τον αριθμό των τιμών"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Διάμεσος"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Επιστρέφει την τιμή που διαχωρίζει το υψηλότερο μισό από το κάτω μισό ανά DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Εύρος"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Επιστρέφει τη διαφορά μεταξύ της μεγαλύτερης και της μικρότερης τιμής ανά DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Interquartile Range"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Επιστρέφει την απόσταση του μέσου 50% γύρω από τη διάμεση τιμή ανά DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Τυπική απόκλιση"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Επιστρέφει την τελευταία τιμή που μετρήθηκε"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Διακύμανση"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Εμφανίζει το float ως ακέραιο"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Xth εκατοστημόριο"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Επιστρέφει την τελευταία τιμή που μετρήθηκε"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$ var: κατώφλι σε ποσοστό. Εύρος: [0 & lt; $ var ≤100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Διάρκεια πάνω από το όριο"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Επιστρέφει τη διάρκεια πάνω από ένα καθορισμένο όριο σε ποσοστό."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$ var: όριο (απόλυτο)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Άθροισμα κατωφλίου"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Επιστρέφει τον αριθμό των τιμών"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Στρογγυλά κλάσματα προς τα κάτω"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Επιστρέφει την επόμενη χαμηλότερη ακέραια τιμή με στρογγυλοποίηση προς τα κάτω, εάν είναι απαραίτητο."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$ var: float"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Στρογγυλά κλάσματα προς τα πάνω"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Επιστρέφει την επόμενη υψηλότερη ακέραια τιμή με στρογγυλοποίηση της τιμής, εάν είναι απαραίτητο."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Round A Float"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Επιστρέφει τη χαμηλότερη τιμή μιας δεδομένης λίστας παραμέτρων"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$ var: τιμή float ή string"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Βρείτε την υψηλότερη τιμή"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Επιστρέφει την υψηλότερη τιμή μιας δεδομένης λίστας παραμέτρων"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$ var1, $ var2, $ var3 ...: τιμές προς σύγκριση"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Βρείτε τη χαμηλότερη τιμή"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Επιστρέφει τη χαμηλότερη τιμή μιας δεδομένης λίστας παραμέτρων"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Λειτουργία υπό όρους - Λογική IF-THEN-ELSE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Επιστρέφει το B αν το A είναι αληθές ή το C εάν το A είναι ψευδές"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Βρείτε αν μια τιμή δεν είναι αριθμός"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Επιστρέφει 1 (ή B) εάν A === NaN ή 0 (ή C) εάν όχι. Οι παράμετροι B και C είναι προαιρετικές."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Σύνθετη σύγκριση"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Ψευδώνυμο του f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Ψευδώνυμο του f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Ψευδώνυμο του f_cmp - ΕΙΝΑΙ Ισοδύναμο"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Επιστρέφει 1 (ή C) εάν A == B ή 0 (ή D) εάν όχι. Οι παράμετροι C και D είναι προαιρετικές."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Ψευδώνυμο του f_cmp - ΕΙΝΑΙ ΑΝΕΞΑΡΤΗΤΟ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Επιστρέφει 1 (ή C) εάν A! = B ή 0 (ή D) εάν όχι. Οι παράμετροι C και D είναι προαιρετικές."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Ψευδώνυμο του f_cmp - ΕΙΝΑΙ ΜΕΓΑΛΥΤΕΡΟ ΑΠΟ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Επιστρέφει 1 (ή C) εάν A> B ή 0 (ή D) εάν όχι. Οι παράμετροι C και D είναι προαιρετικές."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Ψευδώνυμο f_cmp - ΕΙΝΑΙ ΧΑΜΗΛΟΤΕΡΟ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Επιστρέφει 1 (ή C) εάν A <B ή 0 (ή D) εάν όχι. Οι παράμετροι C και D είναι προαιρετικές."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Ψευδώνυμο f_cmp - ΕΙΝΑΙ ΜΕΓΑΛΥΤΕΡΟ Ή ΙΣΟ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Επιστρέφει 1 (ή C) εάν A> = B ή 0 (ή D) εάν όχι. Οι παράμετροι C και D είναι προαιρετικές."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Ψευδώνυμο f_cmp - ΕΙΝΑΙ ΧΑΜΗΛΗ Ή ΙΣΟΙ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Επιστρέφει 1 (ή C) εάν A <= B ή 0 (ή D) εάν όχι. Οι παράμετροι C και D είναι προαιρετικές."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Προσθήκη"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Μαθηματική λειτουργία για να επιστρέψετε το άθροισμα δύο ή περισσότερων συνόλων"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Αφαίρεση"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Μαθηματική λειτουργία για την επιστροφή της διαφοράς του minuend και του subtrahend"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
