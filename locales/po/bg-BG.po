#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Средно аритметично"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Връща средната стойност. (сума от стойности / брой стойности)"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "нищо"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Максимална стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Връща първата измерена стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Минимална стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Връща последната измерена стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Сума"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Връща последната измерена стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Брой стойности (не NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Връща броя на стойностите"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Градиент"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Връща градиента на права линия с помощта на линейна регресия"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Последна стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Връща последната измерена стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Първа стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Връща първата измерена стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Брой NaNs"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Връща броя на стойностите"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - медиана"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Връща стойността, която разделя горната половина от долната половина на DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Обхват"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Връща разликата между най-голямата и най-малката стойност за DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Интерквартилен диапазон"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Връща разстоянието от средата 50% около медианата за DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Стандартно отклонение"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Връща последната измерена стойност"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Дисперсия"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Връща float като цяло число"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X-ти процент"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Връща последната измерена стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$ var: праг в проценти. Обхват: [0 & lt; $ var ≤100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Продължителност над прага"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Връща продължителността над определен праг в проценти."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$ var: праг (абсолютен)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Сума над прага"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Връща броя на стойностите"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Кръгли фракции надолу"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Връща следващата най-ниска целочислена стойност чрез закръгляване надолу, ако е необходимо."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$ var: float"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Кръгли дроби нагоре"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Връща следващата най-висока целочислена стойност чрез закръгляване на стойността, ако е необходимо."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Round A Float"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Връща най-ниската стойност на даден списък от параметри"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$ var: стойност с плувка или низ"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Намерете най-висока стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Връща най-високата стойност на даден списък от параметри"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$ var1, $ var2, $ var3 ...: стойности за сравнение"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Намерете най-ниската стойност"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Връща най-ниската стойност на даден списък от параметри"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Условна операция - АКО-ТОГАВА ДРУГА логика"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Връща B, ако A е вярно или C, ако A е невярно"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Намерете дали дадена стойност не е число"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Връща 1 (или B), ако A === NaN или 0 (или C), ако не. Параметрите B и C не са задължителни."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Сложно сравнение"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Псевдоним на f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Псевдоним на f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Псевдоним на f_cmp - Е РАВНО"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A == B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Псевдоним на f_cmp - Е НЕРАВЕН"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A! = B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Псевдоним на f_cmp - Е ПО-ГОЛЯМ ОТ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A> B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Псевдоним на f_cmp - Е ПО-НИСЪК ОТ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A <B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Псевдоним на f_cmp - Е ПО-ГОЛЯМ ИЛИ РАВЕН"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A> = B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Псевдоним на f_cmp - Е ПО-НИСКИ ИЛИ РАВНИ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A <= B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "допълнение"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Математическа операция за връщане на сумата от две или повече суми"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "изваждане"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Математическа операция за връщане на разликата между минута и изваждането"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "умножение"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Математическа операция за връщане на произведението на умножител и умножител"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Отдел"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Математическа операция за връщане на частта от делител и делител"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Модул"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Математическа операция за връщане на остатъка от деление на две цели числа"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Увеличение - изисква се PHP5.6 или по-висока"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Математическа операция за връщане на многократното умножение (или деление) на база от нейния експонентен показател."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Десетичен сепаратор на CSV"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Символът показва края на целочислената част и началото на дробната част."

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Кръгла скоба"

