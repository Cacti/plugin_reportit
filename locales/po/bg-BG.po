msgstr "f_sd - Стандартно отклонение"

#: include/global_arrays.php:251 lib/const_measurands.php:119
msgid "Returns the square root per data source variance"
msgstr "Връща последната измерена стойност"

#: include/global_arrays.php:257
msgid "f_var - Variance"
msgstr "f_var - Дисперсия"

#: include/global_arrays.php:258
msgid "Returns the variance per DS"
msgstr "Връща float като цяло число"

#: include/global_arrays.php:266 lib/const_measurands.php:149
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X-ти процент"

#: include/global_arrays.php:267 lib/const_measurands.php:150
msgid "Returns the xth percentitle."
msgstr "Връща последната измерена стойност"

#: include/global_arrays.php:268 lib/const_measurands.php:151
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$ var: праг в проценти. Обхват: [0 & lt; $ var ≤100]"

#: include/global_arrays.php:274 lib/const_measurands.php:156
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Продължителност над прага"

#: include/global_arrays.php:275 lib/const_measurands.php:157
msgid "Returns the duration over a defined threshold in percent."
msgstr "Връща продължителността над определен праг в проценти."

#: include/global_arrays.php:276 include/global_arrays.php:284
#: lib/const_measurands.php:158 lib/const_measurands.php:165
msgid "$var: threshold (absolute)"
msgstr "$ var: праг (абсолютен)"

#: include/global_arrays.php:282 lib/const_measurands.php:163
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Сума над прага"

#: include/global_arrays.php:283 lib/const_measurands.php:164
msgid "Returns the sum of values over a defined threshold."
msgstr "Връща броя на стойностите"

#: include/global_arrays.php:290 lib/const_measurands.php:170
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Кръгли фракции надолу"

#: include/global_arrays.php:291 include/global_arrays.php:357
#: lib/const_measurands.php:131 lib/const_measurands.php:171
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Връща следващата най-ниска целочислена стойност чрез закръгляване надолу, ако е необходимо."

#: include/global_arrays.php:292 include/global_arrays.php:300
#: include/global_arrays.php:358 lib/const_measurands.php:132
#: lib/const_measurands.php:172 lib/const_measurands.php:179
msgid "$var: float"
msgstr "$ var: float"

#: include/global_arrays.php:298 lib/const_measurands.php:177
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Кръгли дроби нагоре"

#: include/global_arrays.php:299 lib/const_measurands.php:178
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Връща следващата най-висока целочислена стойност чрез закръгляване на стойността, ако е необходимо."

#: include/global_arrays.php:306 lib/const_measurands.php:184
msgid "f_round - Round A Float"
msgstr "f_round - Round A Float"

#: include/global_arrays.php:307 include/global_arrays.php:365
#: lib/const_measurands.php:138 lib/const_measurands.php:185
msgid "Returns the rounded integer value of any given float."
msgstr "Връща най-ниската стойност на даден списък от параметри"

#: include/global_arrays.php:308 include/global_arrays.php:366
#: lib/const_measurands.php:139 lib/const_measurands.php:186
msgid "$var: float or string value"
msgstr "$ var: стойност с плувка или низ"

#: include/global_arrays.php:314 lib/const_measurands.php:191
msgid "f_high - Find Highest Value"
msgstr "f_high - Намерете най-висока стойност"

#: include/global_arrays.php:315 lib/const_measurands.php:192
msgid "Returns the highest value of a given list of parameters"
msgstr "Връща най-високата стойност на даден списък от параметри"

#: include/global_arrays.php:316 include/global_arrays.php:324
#: lib/const_measurands.php:193 lib/const_measurands.php:200
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$ var1, $ var2, $ var3 ...: стойности за сравнение"

#: include/global_arrays.php:322 lib/const_measurands.php:198
msgid "f_high - Find Lowest Value"
msgstr "f_high - Намерете най-ниската стойност"

#: include/global_arrays.php:323 lib/const_measurands.php:199
msgid "Returns the lowest value of a given list of parameters"
msgstr "Връща най-ниската стойност на даден списък от параметри"

#: include/global_arrays.php:330 lib/const_measurands.php:205
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Условна операция - АКО-ТОГАВА ДРУГА логика"

#: include/global_arrays.php:331 lib/const_measurands.php:206
msgid "Returns B if A is true or C if A is false"
msgstr "Връща B, ако A е вярно или C, ако A е невярно"

#: include/global_arrays.php:338 lib/const_measurands.php:212
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Намерете дали дадена стойност не е число"

#: include/global_arrays.php:339 include/global_arrays.php:347
#: lib/const_measurands.php:213
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Връща 1 (или B), ако A === NaN или 0 (или C), ако не. Параметрите B и C не са задължителни."

#: include/global_arrays.php:346
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Сложно сравнение"

#: include/global_arrays.php:356 lib/const_measurands.php:130
msgid "f_int - Alias of f_floor"
msgstr "f_int - Псевдоним на f_floor"

#: include/global_arrays.php:364 lib/const_measurands.php:137
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Псевдоним на f_round"

#: include/global_arrays.php:372 lib/const_measurands.php:219
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Псевдоним на f_cmp - Е РАВНО"

#: include/global_arrays.php:373 lib/const_measurands.php:220
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A == B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php:380 lib/const_measurands.php:226
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Псевдоним на f_cmp - Е НЕРАВЕН"

#: include/global_arrays.php:381 lib/const_measurands.php:227
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A! = B или 0 (или D), ако не. Параметрите C и D не са задължителни."

#: include/global_arrays.php:388 lib/const_measurands.php:233
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Псевдоним на f_cmp - Е ПО-ГОЛЯМ ОТ"

#: include/global_arrays.php:389 lib/const_measurands.php:234
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Връща 1 (или C), ако A> B или 0 (или D), ако не. Параметрите C и D не са задължителни."

