#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Wastani wa Kihesabu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Hurejesha thamani ya wastani ya thamani zote zilizopimwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "hakuna"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Thamani ya Juu Zaidi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Hurejesha thamani ya juu zaidi iliyopimwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Thamani ya Chini Zaidi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Hurejesha thamani ya chini zaidi iliyopimwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Jumla"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Hurejesha jumla ya thamani zote zilizopimwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Idadi ya Thamani (Zisizo NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Hurejesha idadi ya thamani halali zilizopimwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Mteremko"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Hurejesha mwinuko wa mstari mnyoofu kwa kutumia urejeshi wa mstari kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Thamani ya Mwisho"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Hurejesha thamani ya mwisho halali iliyopimwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Thamani ya Kwanza"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Hurejesha thamani ya kwanza halali iliyopimwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Idadi ya NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Hurejesha idadi ya NaN zilizohifadhiwa kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Mediani"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Hurejesha thamani inayotenganisha nusu ya juu na nusu ya chini kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Masafa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Hurejesha tofauti kati ya thamani kubwa zaidi na thamani ndogo zaidi kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Masafa ya Kati ya Roboi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Hurejesha umbali wa 50&#037; ya kati kuzunguka thamani ya kati kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Mchepuko Sanifu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Hurejesha kipeuo cha pili cha tofauti kwa kila Chanzo cha Data"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Variansi"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Hurejesha tofauti ya takwimu kwa kila DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Pisentili ya X"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Hurejesha asilimia ya x."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: kizingiti kwa asilimia. Masafa: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Muda Juu ya Kizingiti"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Hurejesha muda uliozidi kizingiti kilichobainishwa kwa asilimia."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: kizingiti (halisi)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Jumla Juu ya Kizingiti"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Hurejesha jumla ya thamani zinazozidi kizingiti kilichobainishwa."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Kadiria Sehemu Chini"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Hurejesha thamani ya nambari kamili ya chini inayofuata kwa kukadiria chini ikihitajika."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: desimali"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Kadiria Sehemu Juu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Hurejesha thamani ya nambari kamili ya juu inayofuata kwa kukadiria juu ikihitajika."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Kadiria Nambari ya Desimali"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Hurejesha thamani ya nambari kamili iliyokadiriwa ya desimali yoyote iliyotolewa."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: thamani ya desimali au mfuatano"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Tafuta Thamani ya Juu Zaidi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Hurejesha thamani ya juu zaidi kutoka kwenye orodha ya vigezo vilivyotolewa"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: thamani za kulinganishwa"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Tafuta Thamani ya Chini Zaidi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Hurejesha thamani ya chini zaidi kutoka kwenye orodha ya vigezo vilivyotolewa"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Operesheni ya Masharti - Mantiki ya KAMA-BASI-VINGINEVYO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Hurejesha B ikiwa A ni kweli au C ikiwa A ni uwongo"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Tafuta kama thamani si nambari"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Hurejesha 1 (au B) ikiwa A === NaN au 0 (au C) ikiwa sivyo. Vigezo B na C ni vya hiari."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Ulinganisho Changamano"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Jina mbadala la f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Jina mbadala la f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Jina mbadala la f_cmp - NI SAWA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Hurejesha 1 (au C) ikiwa A == B au 0 (au D) ikiwa sivyo. Vigezo C na D ni vya hiari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Jina mbadala la f_cmp - SI SAWA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Hurejesha 1 (au C) ikiwa A != B au 0 (au D) ikiwa sivyo. Vigezo C na D ni vya hiari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Jina mbadala la f_cmp - NI KUBWA KULIKO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Hurejesha 1 (au C) ikiwa A > B au 0 (au D) ikiwa sivyo. Vigezo C na D ni vya hiari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Jina mbadala la f_cmp - NI NDOGO KULIKO"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Hurejesha 1 (au C) ikiwa A < B au 0 (au D) ikiwa sivyo. Vigezo C na D ni vya hiari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Jina mbadala la f_cmp - NI KUBWA AU SAWA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Hurejesha 1 (au C) ikiwa A >= B au 0 (au D) ikiwa sivyo. Vigezo C na D ni vya hiari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Jina mbadala la f_cmp - NI NDOGO AU SAWA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Hurejesha 1 (au C) ikiwa A <= B au 0 (au D) ikiwa sivyo. Vigezo C na D ni vya hiari."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Nyongeza"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Operesheni ya Kihisabati ya kurejesha jumla ya vijumlishwa viwili au zaidi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Kutoa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Operesheni ya Kihisabati ya kurejesha tofauti kati ya namba inayopunguzwa na namba inayotoa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Uzidishaji"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Operesheni ya Kihisabati ya kurejesha zao la kizidishio na kizidishwa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Mgawanyo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Operesheni ya Kihisabati ya kurejesha sehemu ya kigawanywa na kigawanyo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Moduli"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Operesheni ya Kihisabati ya kurejesha baki ya mgawanyo wa namba kamili mbili"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Kipeo - PHP5.6 au toleo jipya zaidi linahitajika"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Operesheni ya Kihisabati ya kurejesha uzidishaji (au mgawanyo) unaorudiwa wa msingi kwa kipeo chake."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Alama ya Desimali"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Alama ya Desimali inayotumika kutenganisha sehemu kamili na sehemu ya sehemu"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Bano la Duara"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Hutumika kubatilisha utangulizi wa kawaida au kuashiria kiwango cha kwanza cha uwekaji ndani"

#: include/global_arrays.php
msgid "Square Bracket"
msgstr "Bano Mraba"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the second level of nesting"
msgstr "Hutumika kubatilisha utangulizi wa kawaida au kuashiria kiwango cha pili cha uwekaji ndani"

#: include/global_arrays.php
msgid "Punctuation mark"
msgstr "Alama ya uakifishaji"

