#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Aritmētiskais vidējais"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Atgriež visu izmērīto vērtību vidējo vērtību katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "nav"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Maksimālā vērtība"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Atgriež lielāko izmērīto vērtību katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Minimālā vērtība"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Atgriež mazāko izmērīto vērtību katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Summa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Atgriež visu izmērīto vērtību summu katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Vērtību skaits (nav NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Atgriež derīgo izmērīto vērtību skaitu katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Gradients"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Atgriež taisnes gradientu, izmantojot lineāro regresiju katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Pēdējā vērtība"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Atgriež pēdējo derīgo izmērīto vērtību katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Pirmā vērtība"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Atgriež pirmo derīgo izmērīto vērtību katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - NaN vērtību skaits"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Atgriež saglabāto NaN vērtību skaitu katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Mediāna"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Atgriež vērtību, kas atdala augstāko pusi no zemākās puses katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Diapazons"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Atgriež starpību starp lielāko un mazāko vērtību katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Starpkvartiļu diapazons"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Atgriež vidējo 50&#037; attālumu ap mediānu katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Standartnovirze"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Atgriež kvadrātsakni no datu avota dispersijas"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Dispersija"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Atgriež dispersiju katram DS"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X. procentile"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Atgriež x. procentili."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: slieksnis procentos. Diapazons: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Ilgums virs sliekšņa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Atgriež ilgumu virs noteiktā sliekšņa procentos."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: slieksnis (absolūtais)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Summa virs sliekšņa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Atgriež vērtību summu virs noteiktā sliekšņa."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Noapaļot daļskaitli uz leju"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Atgriež nākamo zemāko veselo skaitli, nepieciešamības gadījumā noapaļojot vērtību uz leju."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: peldošā komata skaitlis"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Noapaļot daļskaitli uz augšu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Atgriež nākamo augstāko veselo skaitli, nepieciešamības gadījumā noapaļojot vērtību uz augšu."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Noapaļot peldošā komata skaitli"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Atgriež noapaļoto veselo skaitli jebkuram dotajam peldošā komata skaitlim."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: peldošā komata skaitlis vai virknes vērtība"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Atrast lielāko vērtību"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Atgriež lielāko vērtību no dotā parametru saraksta"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: salīdzināmās vērtības"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Atrast mazāko vērtību"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Atgriež mazāko vērtību no dotā parametru saraksta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Nosacījuma darbība - IF-THEN-ELSE loģika"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Atgriež B, ja A ir patiess, vai C, ja A ir aplams"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Pārbaudīt, vai vērtība nav skaitlis"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Atgriež 1 (vai B), ja A === NaN, vai 0 (vai C), ja nav. Parametri B un C nav obligāti."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Kompleksais salīdzinājums"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - f_floor aizstājvārds"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - f_round aizstājvārds"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - f_cmp aizstājvārds - IR VIENĀDS"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Atgriež 1 (vai C), ja A == B, vai 0 (vai D), ja nav. Parametri C un D nav obligāti."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - f_cmp aizstājvārds - NAV VIENĀDS"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Atgriež 1 (vai C), ja A != B, vai 0 (vai D), ja nav. Parametri C un D nav obligāti."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - f_cmp aizstājvārds - IR LIELĀKS PAR"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Atgriež 1 (vai C), ja A > B, vai 0 (vai D), ja nav. Parametri C un D nav obligāti."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - f_cmp aizstājvārds - IR MAZĀKS PAR"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Atgriež 1 (vai C), ja A < B, vai 0 (vai D), ja nav. Parametri C un D nav obligāti."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - f_cmp aizstājvārds - IR LIELĀKS VAI VIENĀDS"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Atgriež 1 (vai C), ja A >= B, vai 0 (vai D), ja nav. Parametri C un D nav obligāti."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - f_cmp aizstājvārds - IR MAZĀKS VAI VIENĀDS"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Atgriež 1 (vai C), ja A <= B, vai 0 (vai D), ja nav. Parametri C un D nav obligāti."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Saskaitīšana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Matemātiska darbība divu vai vairāku saskaitāmo summas iegūšanai"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Atņemšana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Matemātiska darbība mazināmā un mazinātāja starpības iegūšanai"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Reizināšana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Matemātiska darbība reizinātāja un reizināmā reizinājuma iegūšanai"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Dalīšana"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Matemātiska darbība dalāmā un dalītāja dalījuma iegūšanai"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Modulis"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Matemātiska darbība divu veselu skaitļu dalīšanas atlikuma iegūšanai"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Kāpināšana - nepieciešama PHP5.6 vai jaunāka versija"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Matemātiska darbība bāzes atkārtotai reizināšanai (vai dalīšanai) ar kāpinātāju."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Decimālatdalītājs"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Decimālatdalītājs, ko izmanto veselās daļas atdalīšanai no daļskaitļa daļas"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Apaļās iekavas"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Izmanto, lai mainītu parasto darbību secību vai apzīmētu pirmo ligzdošanas līmeni"

#: include/global_arrays.php
msgid "Square Bracket"
