#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Celceliska Xisaabta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Waxay soo celisaa celceliska qiimaha dhammaan qiimayaasha la cabbiray DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "waxba"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Qiimaha Ugu Badan"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Waxay soo celisaa qiimaha ugu sarreeya ee la cabbiray DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Qiimaha Ugu Yar"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Waxay soo celisaa qiimaha ugu hooseeya ee la cabbiray DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Wadarta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Waxay soo celisaa wadarta dhammaan qiimayaasha la cabbiray DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Tirada Qiimayaasha (Aan NaN Ahayn)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Waxay soo celisaa tirada qiimayaasha saxda ah ee la cabbiray DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Janjeerka"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Waxay soo celisaa jiirada xariiq toosan iyadoo la adeegsanayo dib-u-celinta toosan DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Qiimaha Ugu Dambeeya"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Waxay soo celisaa qiimaha ugu dambeeya ee saxda ah ee la cabbiray DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Qiimaha Koowaad"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Waxay soo celisaa qiimaha koowaad ee saxda ah ee la cabbiray DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Tirada NaN-yada"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Waxay soo celisaa tirada NaN-yada ku kaydsan DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Dhexdhexaadka"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Waxay soo celisaa qiimaha kala sooca qaybta sare iyo qaybta hoose DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Baaxadda"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Waxay soo celisaa farqiga u dhexeeya qiimaha ugu weyn iyo kan ugu yar DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Kala Duwanaanshaha Afarmeedyada Dhexe"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Waxay soo celisaa fogaanta 50&#037; ee dhexe ee ku wareegsan qiimaha dhexe DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Weecitaanka Caadiga ah"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Waxay soo celisaa xididka labajibbaaran ee kala duwanaanshaha isha xogta kasta"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Kala Duwanaanshaha"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Waxay soo celisaa kala duwanaanshaha DS kasta"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Boqolleyda X-aad"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Waxay soo celisaa boqolleyga x-aad."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: xadka boqolkiiba. Kala duwanaanshaha: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Muddada Xadka Dhaaftay"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Waxay soo celisaa muddada ka sarraysa xadka la cayimay iyadoo boqolkiiba ah."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: xadka (buuxa)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Wadarta Xadka Dhaaftay"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Waxay soo celisaa wadarta qiimayaasha ka sarreeya xadka la cayimay."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Jajabyada Hoos U Wareeji"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Waxay soo celisaa tirada buuxda ee xigta ee ugu hoosaysa iyadoo hoos loo wareejinayo qiimaha haddii loo baahdo."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: tiro jajab ah"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Jajabyada Kor U Wareeji"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Waxay soo celisaa tirada buuxda ee xigta ee ugu sarraysa iyadoo kor loo wareejinayo qiimaha haddii loo baahdo."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Wareeji Tiro Jajab Leh"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Waxay soo celisaa tirada buuxda ee la wareejiyay ee tiro kasta oo jajab tobanle ah."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: tiro jajab ah ama qiime xarfo ah"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Hel Qiimaha Ugu Sarreeya"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Waxay soo celisaa qiimaha ugu sarreeya ee liiska halbeegyada la bixiyay"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: qiimayaasha la isbarbardhigayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Hel Qiimaha Ugu Hooseeya"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Waxay soo celisaa qiimaha ugu hooseeya ee liiska halbeegyada la bixiyay"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Hawlgal Shuruudaysan - Caqliga HADDII-MARKAA-HADDII KALE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Waxay soo celisaa B haddii A run yahay, ama C haddii A been yahay"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Hubi haddii qiime uusan ahayn tiro"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Waxay soo celisaa 1 (ama B) haddii A === NaN, ama 0 (ama C) haddii kale. Halbeegyada B iyo C waa ikhtiyaari."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Isbarbardhigga Adag"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Magac kale oo f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Magac kale oo f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Magac kale oo f_cmp - WAA LA MID"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Waxay soo celisaa 1 (ama C) haddii A == B, ama 0 (ama D) haddii kale. Halbeegyada C iyo D waa ikhtiyaari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Magac kale oo f_cmp - AAN LA MID AHAYN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Waxay soo celisaa 1 (ama C) haddii A != B, ama 0 (ama D) haddii kale. Halbeegyada C iyo D waa ikhtiyaari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Magac kale oo f_cmp - KA WEYN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Waxay soo celisaa 1 (ama C) haddii A > B, ama 0 (ama D) haddii kale. Halbeegyada C iyo D waa ikhtiyaari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Magac kale oo f_cmp - KA YAR"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Waxay soo celisaa 1 (ama C) haddii A < B, ama 0 (ama D) haddii kale. Halbeegyada C iyo D waa ikhtiyaari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Magac kale oo f_cmp - KA WEYN AMA LA MID"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Waxay soo celisaa 1 (ama C) haddii A >= B, ama 0 (ama D) haddii kale. Halbeegyada C iyo D waa ikhtiyaari."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Magac kale oo f_cmp - KA YAR AMA LA MID"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Waxay soo celisaa 1 (ama C) haddii A <= B, ama 0 (ama D) haddii kale. Halbeegyada C iyo D waa ikhtiyaari."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Kordhin"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Hawlgal Xisaabeed oo soo celiya wadarta laba ama in ka badan oo la isku daro"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Ka-jaris"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Hawlgal Xisaabeed oo soo celiya farqiga u dhexeeya tirada laga jaro iyo tirada la jaro"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Isku-dhufasho"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Hawlgal Xisaabeed oo soo celiya taranka isku-dhuftaha iyo kan lagu dhufto"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Qaybta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Hawlgal Xisaabeed oo soo celiya qaybta tirada la qaybiyo iyo qaybiyaha"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Hadhaaga qaybinta"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Hawlgal Xisaabeed oo soo celiya hadhaaga qaybinta laba tiro oo dhan"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Jibbaaris - Waxaa loo baahan yahay PHP5.6 ama ka sarreeya"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Hawlgal Xisaabeed oo soo celiya isku-dhufashada (ama qaybinta) soo noqnoqota ee saldhigga iyo jibbaarkiisa."

