#, php-format
msgid "Metric: %s"
msgstr "Imetrikhi: %s"

#: templates.php
msgid "You must select at least one measurand."
msgstr "Kufuneka ukhethe ubuncinane into elinganiswayo enye."

#: templates.php
msgid "Delete Template Metrics"
msgstr "Cima iiMetriki zeTempleyiti"

#: templates.php
#, php-format
msgid "Variables [ Template: %s - %s ]"
msgstr "Iziguquguquki [ Itempleyiti: %s - %s ]"

