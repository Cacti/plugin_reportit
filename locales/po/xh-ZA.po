#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Umyinge we-Arithmetic"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "Ibuyisela ixabiso eliphakathi lawo onke amaxabiso alinganisiweyo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "akukho"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Elona Xabiso Liphezulu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "Ibuyisela elona xabiso liphezulu lilinganisiweyo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Elona Xabiso Lisezantsi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "Ibuyisela elona xabiso lisezantsi lilinganisiweyo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Isixa"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "Ibuyisela isixa sawo onke amaxabiso alinganisiweyo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Inani Lamaxabiso (Angengawo ama-NaN)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "Ibuyisela inani lamaxabiso alinganisiweyo asebenzayo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Uthambeko"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "Ibuyisela ithambeka lomgca othe tye ngokusebenzisa i-linear regression kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Ixabiso Lokugqibela"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "Ibuyisela ixabiso lokugqibela elilinganisiweyo elisebenzayo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - Ixabiso Lokuqala"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "Ibuyisela ixabiso lokuqala elilinganisiweyo elisebenzayo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - Inani lee-NaN"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "Ibuyisela inani lee-NaN ezigciniweyo kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - I-Median"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "Ibuyisela elo xabiso lahlula isiqingatha esiphezulu kwisiqingatha esisezantsi kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Uluhlu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "Ibuyisela umahluko phakathi kwexabiso elikhulu nelincinci kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Uluhlu lwe-Interquartile"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Ibuyisela umgama wama-50&#037; aphakathi ajikeleze i-median kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - I-Standard Deviation"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Ibuyisela i-square root yomahluko womthombo wedatha ngamnye"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - I-Variance"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "Ibuyisela i-variance kwi-DS nganye"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - Ipesenti ye-Xth"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "Ibuyisela i-percentile yesi-x."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: umda ngepesenti. Uluhlu: [0&lt; $var &le;100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Ixesha Elidlule kuMda"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Ibuyisela ixesha elidlulileyo phezu komda ochaziweyo ngepesenti."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: umda (opheleleyo)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Isixa Esidlule kuMda"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Ibuyisela isixa samaxabiso aphezu komda ochaziweyo."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Jikelezisa Amaqhezu Phantsi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Ibuyisela ixabiso elilandelayo elisezantsi lenani elipheleleyo ngokungqukuva ezantsi ixabiso ukuba kuyimfuneko."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: inani elinedesimali"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Jikelezisa Amaqhezu Phezulu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Ibuyisela ixabiso elilandelayo eliphezulu lenani elipheleleyo ngokungqukuva phezulu ixabiso ukuba kuyimfuneko."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Jikelezisa i-Float"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Ibuyisela ixabiso lenani elipheleleyo elingqukuviweyo lalo naliphi na inani elinedesimali elinikiweyo."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: ixabiso lenani elinedesimali okanye umtya"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - Fumana Elona Xabiso Liphezulu"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Ibuyisela elona xabiso liphezulu kuluhlu lweeparamitha olunikiweyo"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var1, $var2, $var3 ...: amaxabiso aza kuthelekiswa"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - Fumana Elona Xabiso Lisezantsi"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Ibuyisela elona xabiso lisezantsi kuluhlu lweeparamitha olunikiweyo"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Umsebenzi Onemiqathango - Ingqiqo ye-IF-THEN-ELSE"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "Ibuyisela u-B ukuba u-A uyinyani okanye u-C ukuba u-A ububuxoki"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Fumana ukuba ixabiso asilonani na"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "Ibuyisela u-1 (okanye u-B) ukuba u-A === NaN okanye u-0 (okanye u-C) ukuba akunjalo. Iiparamitha B no-C azikho sinyanzelo."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Uthelekiso Oluntsonkothileyo"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - Igama elinye le-f_floor"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - Igama elinye le-f_round"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - Igama elinye le-f_cmp - IYALINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (okanye u-C) ukuba u-A == B okanye u-0 (okanye u-D) ukuba akunjalo. Iiparamitha C no-D azikho sinyanzelo."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - Igama elinye le-f_cmp - AYILINGANI"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (okanye u-C) ukuba u-A != B okanye u-0 (okanye u-D) ukuba akunjalo. Iiparamitha C no-D azikho sinyanzelo."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - Igama elinye le-f_cmp - INKULU KUNA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (okanye u-C) ukuba u-A > B okanye u-0 (okanye u-D) ukuba akunjalo. Iiparamitha C no-D azikho sinyanzelo."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - Igama elinye le-f_cmp - INCINCI KUNA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (okanye u-C) ukuba u-A < B okanye u-0 (okanye u-D) ukuba akunjalo. Iiparamitha C no-D azikho sinyanzelo."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - Igama elinye le-f_cmp - INKULU OKANYE IYALINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (okanye u-C) ukuba u-A >= B okanye u-0 (okanye u-D) ukuba akunjalo. Iiparamitha C no-D azikho sinyanzelo."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - Igama elinye le-f_cmp - INCINCI OKANYE IYALINGANA"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "Ibuyisela u-1 (okanye u-C) ukuba u-A <= B okanye u-0 (okanye u-D) ukuba akunjalo. Iiparamitha C no-D azikho sinyanzelo."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "Ukongeza"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "Umsebenzi weMathematika wokubuyisela isixa samanani amabini okanye nangaphezulu adityaniswayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Ukuthabatha"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Umsebenzi weMathematika wokubuyisela umahluko wenani elithatyathwayo nelithabathayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Uphindaphindo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Umsebenzi weMathematika wokubuyisela imveliso yomphindaphindi nenani eliphindaphindwayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Ulwahlulo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Umsebenzi weMathematika wokubuyisela iqhezu lenani elahlulwayo nelahlulayo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "I-Modulus"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "Umsebenzi weMathematika wokubuyisela intsalela yokwahlulwa kwamanani amabini apheleleyo"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Ukuphakamisa amandla - Kufuneka i-PHP5.6 okanye ngaphezulu"

