msgstr "$var 1, $var 2, $var 3 ...: karşılaştırılacak değerler"

#: include/global_arrays.php:320 lib/const_measurands.php:198
msgid "f_high - Find Lowest Value"
msgstr "f_high - En Düşük Değeri Bul"

#: include/global_arrays.php:321 lib/const_measurands.php:199
msgid "Returns the lowest value of a given list of parameters"
msgstr "Belirli bir parametre listesinin en düşük değerini verir"

#: include/global_arrays.php:328 lib/const_measurands.php:205
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Koşullu İşlem - IF-THEN-ELSE Mantığı"

#: include/global_arrays.php:329 lib/const_measurands.php:206
msgid "Returns B if A is true or C if A is false"
msgstr "A doğruysa B'yi, A yanlışsa C'yi döndürür"

#: include/global_arrays.php:336 lib/const_measurands.php:212
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Bir değerin sayı olup olmadığını bulun"

#: include/global_arrays.php:337 include/global_arrays.php:345
#: lib/const_measurands.php:213
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "A ise 1 (veya B) döndürür = NaN değilse 0 (veya C). B ve C parametreleri isteğe bağlıdır."

#: include/global_arrays.php:344
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Karmaşık Karşılaştırma"

#: include/global_arrays.php:354 lib/const_measurands.php:130
msgid "f_int - Alias of f_floor"
msgstr "f_int - f_floor Takma Adı"

#: include/global_arrays.php:362 lib/const_measurands.php:137
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - f_round'ın takma adı"

#: include/global_arrays.php:370 lib/const_measurands.php:219
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - f_cmp'ın diğer adı - EŞITTIR"

#: include/global_arrays.php:371 lib/const_measurands.php:220
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A == B ise 1 (veya C) veya değilse 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php:378 lib/const_measurands.php:226
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - f_cmp'ın Takma Adı - EŞİTSİZ"

#: include/global_arrays.php:379 lib/const_measurands.php:227
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C) döndürür != B veya değilse 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php:386 lib/const_measurands.php:233
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - f_cmp'un takma adı - BÜYÜKTÜR"

#: include/global_arrays.php:387 lib/const_measurands.php:234
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C) > B veya değilse 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php:394 lib/const_measurands.php:240
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - f_cmp Takma Adı - ŞUNDAN DÜŞÜK"

#: include/global_arrays.php:395 lib/const_measurands.php:241
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C), değilse B < 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

