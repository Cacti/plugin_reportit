#: include/global_arrays.php lib/const_measurands.php
msgid "f_avg - Arithmetic Average"
msgstr "f_avg - Aritmetik Ortalama"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the average value of all measured values per DS"
msgstr "DS başına ölçülen tüm değerlerin ortalama değerini verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "none"
msgstr "yok"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_max - Maximum Value"
msgstr "f_max - Maksimum Değer"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest measured value per DS"
msgstr "DS başına ölçülen en yüksek değeri verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_min - Minimum Value"
msgstr "f_min - Minimum Değer"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest measured value per DS"
msgstr "DS başına ölçülen en düşük değeri verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sum - Sum"
msgstr "f_sum - Toplam"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of all measured values per DS"
msgstr "DS başına ölçülen tüm değerlerin toplamını verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_num - Number of Values (Not NaN)"
msgstr "f_num - Değer Sayısı (NaN Değil)"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of valid measured values per DS"
msgstr "DS başına geçerli ölçülen değerlerin sayısını verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_grd - Gradient"
msgstr "f_grd - Gradyan"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the gradient of a straight line by using linear regression per DS"
msgstr "DS başına doğrusal regresyon kullanarak düz bir çizginin gradyanını verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_last - Last Value"
msgstr "f_last - Son Değer"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the last valid measured value per DS"
msgstr "DS başına son geçerli ölçülen değeri verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_1st - First Value"
msgstr "f_1st - İlk Değer"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the first valid measured value per DS"
msgstr "DS başına ilk geçerli ölçülen değeri verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_nan - Number of NaNs"
msgstr "f_nan - NaN Sayısı"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the number of NaNs stored per DS"
msgstr "DS başına depolanan NaN sayısını verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_median - Median"
msgstr "f_median - Medyan"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "DS başına üst yarıyı alt yarıdan ayıran değeri döndürür"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_range - Range"
msgstr "f_range - Aralık"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "DS başına en büyük ve en küçük değer arasındaki farkı verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Çeyrekler Arası Aralık"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Ortadaki %50'nin DS başına medyan etrafındaki mesafesini verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Standart Sapma"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the square root per data source variance"
msgstr "Her veri kaynağı varyansı için karekökü verir"

#: include/global_arrays.php
msgid "f_var - Variance"
msgstr "f_var - Varyans"

#: include/global_arrays.php
msgid "Returns the variance per DS"
msgstr "DS'ye göre varyansı verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X'inci yüzdebirlik dilim"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the xth percentitle."
msgstr "x'inci yüzdebirlik bölümü verir."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: yüzde olarak eşik. Aralık: [0&lt; $var ≤100]"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Eşiği aşan süre"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the duration over a defined threshold in percent."
msgstr "Tanımlı bir eşiğin üzerindeki süreyi yüzde cinsinden verir."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: threshold (absolute)"
msgstr "$var: eşik (mutlak)"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Eşik Üzerinde Toplam"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the sum of values over a defined threshold."
msgstr "Tanımlı bir eşiğin üzerindeki değerlerin toplamını döndürür."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Kesirleri Aşağı Yuvarlama"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Gerekirse değeri aşağı yuvarlayarak bir sonraki en küçük tamsayı değerini döndürür."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float"
msgstr "$var: Şamandıra"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Kesirleri Yukarı Yuvarlama"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Gerekirse, değeri yukarı yuvarlayarak bir sonraki en yüksek tamsayı değerini döndürür."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_round - Round A Float"
msgstr "f_round - Yuvarlak Bir Şamandıra"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the rounded integer value of any given float."
msgstr "Belirli bir float'ın yuvarlanmış tamsayı değerini döndürür."

#: include/global_arrays.php lib/const_measurands.php
msgid "$var: float or string value"
msgstr "$var: float veya dize değeri"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Highest Value"
msgstr "f_high - En Yüksek Değeri Bul"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the highest value of a given list of parameters"
msgstr "Belirli bir parametre listesinin en yüksek değerini döndürür"

#: include/global_arrays.php lib/const_measurands.php
msgid "$var1, $var2, $var3 ...: values to be compared"
msgstr "$var 1, $var 2, $var 3 ...: karşılaştırılacak değerler"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_high - Find Lowest Value"
msgstr "f_high - En Düşük Değeri Bul"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns the lowest value of a given list of parameters"
msgstr "Belirli bir parametre listesinin en düşük değerini verir"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_if - Conditional Operation - IF-THEN-ELSE Logic"
msgstr "f_if - Koşullu İşlem - IF-THEN-ELSE Mantığı"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns B if A is true or C if A is false"
msgstr "A doğruysa B'yi, A yanlışsa C'yi döndürür"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_isNaN - Find whether a value is not a number"
msgstr "f_isNaN - Bir değerin sayı olup olmadığını bulun"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or B) if A === NaN or 0 (or C) if not. Parameters B and C are optional."
msgstr "A ise 1 (veya B) döndürür = NaN değilse 0 (veya C). B ve C parametreleri isteğe bağlıdır."

#: include/global_arrays.php
msgid "f_cmp - Complex Comparison"
msgstr "f_cmp - Karmaşık Karşılaştırma"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_int - Alias of f_floor"
msgstr "f_int - f_floor Takma Adı"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_rnd - Alias of f_round"
msgstr "f_rnd - f_round'ın takma adı"

#: include/global_arrays.php lib/const_measurands.php
msgid "f_eq - Alias of f_cmp - IS EQUAL"
msgstr "f_eq - f_cmp'ın diğer adı - EŞITTIR"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A == B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A == B ise 1 (veya C) veya değilse 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_uq - Alias of f_cmp - IS UNEQUAL"
msgstr "f_uq - f_cmp'ın Takma Adı - EŞİTSİZ"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A != B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C) döndürür != B veya değilse 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_gt - Alias of f_cmp - IS GREATER THAN"
msgstr "f_gt - f_cmp'un takma adı - BÜYÜKTÜR"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A > B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C) > B veya değilse 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_lt - Alias of f_cmp - IS LOWER THAN"
msgstr "f_lt - f_cmp Takma Adı - ŞUNDAN DÜŞÜK"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A < B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C), değilse B < 0 (veya D) döndürür. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_ge - Alias of f_cmp - IS GREATER OR EQUAL"
msgstr "f_ge - f_cmp'in takma adı - DAHA BÜYÜK VEYA EŞİT"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A >= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C) döndürür >= B değilse 0 (veya D) verir. C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php lib/const_measurands.php
msgid "f_le - Alias of f_cmp - IS LOWER OR EQUAL"
msgstr "f_le - f_cmp'in takma adı - DAHA DÜŞÜK VEYA EŞİT"

#: include/global_arrays.php lib/const_measurands.php
msgid "Returns 1 (or C) if A <= B or 0 (or D) if not. Parameters C and D are optional."
msgstr "A ise 1 (veya C) döndürür <= B değilse 0 (veya D). C ve D parametreleri isteğe bağlıdır."

#: include/global_arrays.php lib/const_measurands.php
msgid "Addition"
msgstr "İlave"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the sum of two or more summands"
msgstr "İki veya daha fazla toplamın toplamını döndürmek için Matematiksel İşlem"

#: include/global_arrays.php lib/const_measurands.php
msgid "Subtraction"
msgstr "Çıkarma"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the difference of minuend and subtrahend"
msgstr "Eksi ve çıkarma farkını döndürmek için Matematiksel İşlem"

#: include/global_arrays.php lib/const_measurands.php
msgid "Multiplication"
msgstr "Çarpma"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the product of multiplier and multiplicant"
msgstr "Çarpan ve çarpımın çarpımını döndürmek için Matematiksel İşlem"

#: include/global_arrays.php lib/const_measurands.php
msgid "Division"
msgstr "Bölüm"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the fraction of divident and divisor"
msgstr "Bölen ve bölen kesrini döndürmek için Matematiksel İşlem"

#: include/global_arrays.php lib/const_measurands.php
msgid "Modulus"
msgstr "Modülü"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the remainder of a division of two integers"
msgstr "İki tamsayının bölünmesinin kalanını döndürmek için Matematiksel İşlem"

#: include/global_arrays.php lib/const_measurands.php
msgid "Exponentiation - PHP5.6 or above required"
msgstr "Üs - PHP5.6 veya üstü gereklidir"

#: include/global_arrays.php lib/const_measurands.php
msgid "Mathematical Operation to return the repeated multiplication (or division) of a base by its exponent."
msgstr "Bir tabanın üssü ile tekrarlanan çarpımını (veya bölümünü) döndürmek için Matematiksel İşlem."

#: include/global_arrays.php
msgid "Decimal Mark"
msgstr "Ondalık İşareti"

#: include/global_arrays.php
msgid "Decimal Mark used to separate the integer part from the fractional part"
msgstr "Ondalık İşaret tamsayı kısmını kesirli kısımdan ayırmak için kullanılır"

#: include/global_arrays.php
msgid "Round Bracket"
msgstr "Yuvarlak Braket"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the first level of nesting"
msgstr "Normal önceliği geçersiz kılmak veya ilk iç içe geçme düzeyini işaretlemek için kullanılır"

#: include/global_arrays.php
msgid "Square Bracket"
msgstr "Köşeli parantez"

#: include/global_arrays.php lib/const_measurands.php
msgid "Used to override normal precedence or to mark the second level of nesting"
msgstr "Normal önceliği geçersiz kılmak veya ikinci iç içe geçme düzeyini işaretlemek için kullanılır"

#: include/global_arrays.php
msgid "Punctuation mark"
msgstr "Noktalama işareti"

