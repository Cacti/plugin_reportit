msgid "f_1st - First Value"
msgstr "f_1st - İlk Değer"

#: include/global_arrays.php:214 lib/const_measurands.php:77
msgid "Returns the first valid measured value per DS"
msgstr "DS başına ilk geçerli ölçülen değeri verir"

#: include/global_arrays.php:220 lib/const_measurands.php:83
msgid "f_nan - Number of NaNs"
msgstr "f_nan - NaN Sayısı"

#: include/global_arrays.php:221 lib/const_measurands.php:84
msgid "Returns the number of NaNs stored per DS"
msgstr "DS başına depolanan NaN sayısını verir"

#: include/global_arrays.php:227 lib/const_measurands.php:90
msgid "f_median - Median"
msgstr "f_median - Medyan"

#: include/global_arrays.php:228 lib/const_measurands.php:91
msgid "Returns that value that separates the higher half from the lower half per DS"
msgstr "DS başına üst yarıyı alt yarıdan ayıran değeri döndürür"

#: include/global_arrays.php:234 lib/const_measurands.php:104
msgid "f_range - Range"
msgstr "f_range - Aralık"

#: include/global_arrays.php:235 lib/const_measurands.php:105
msgid "Returns the difference between the largest and the smallest value per DS"
msgstr "DS başına en büyük ve en küçük değer arasındaki farkı verir"

#: include/global_arrays.php:241 lib/const_measurands.php:111
msgid "f_iqr - Interquartile Range"
msgstr "f_iqr - Çeyrekler Arası Aralık"

#: include/global_arrays.php:242 lib/const_measurands.php:112
msgid "Returns the distance of the middle50&#037; around the median per DS"
msgstr "Ortadaki %50'nin DS başına medyan etrafındaki mesafesini verir"

#: include/global_arrays.php:248 lib/const_measurands.php:118
msgid "f_sd - Standard Deviation"
msgstr "f_sd - Standart Sapma"

#: include/global_arrays.php:249 lib/const_measurands.php:119
msgid "Returns the square root per data source variance"
msgstr "Her veri kaynağı varyansı için karekökü verir"

#: include/global_arrays.php:255
msgid "f_var - Variance"
msgstr "f_var - Varyans"

#: include/global_arrays.php:256
msgid "Returns the variance per DS"
msgstr "DS'ye göre varyansı verir"

#: include/global_arrays.php:264 lib/const_measurands.php:149
msgid "f_xth - Xth Percentile"
msgstr "f_xth - X'inci yüzdebirlik dilim"

#: include/global_arrays.php:265 lib/const_measurands.php:150
msgid "Returns the xth percentitle."
msgstr "x'inci yüzdebirlik bölümü verir."

#: include/global_arrays.php:266 lib/const_measurands.php:151
msgid "$var: threshold in percent. Range: [0&lt; $var &le;100]"
msgstr "$var: yüzde olarak eşik. Aralık: [0&lt; $var ≤100]"

#: include/global_arrays.php:272 lib/const_measurands.php:156
msgid "f_dot - Duration Over Threshold"
msgstr "f_dot - Eşiği aşan süre"

#: include/global_arrays.php:273 lib/const_measurands.php:157
msgid "Returns the duration over a defined threshold in percent."
msgstr "Tanımlı bir eşiğin üzerindeki süreyi yüzde cinsinden verir."

#: include/global_arrays.php:274 include/global_arrays.php:282
#: lib/const_measurands.php:158 lib/const_measurands.php:165
msgid "$var: threshold (absolute)"
msgstr "$var: eşik (mutlak)"

#: include/global_arrays.php:280 lib/const_measurands.php:163
msgid "f_sot - Sum Over Threshold"
msgstr "f_sot - Eşik Üzerinde Toplam"

#: include/global_arrays.php:281 lib/const_measurands.php:164
msgid "Returns the sum of values over a defined threshold."
msgstr "Tanımlı bir eşiğin üzerindeki değerlerin toplamını döndürür."

#: include/global_arrays.php:288 lib/const_measurands.php:170
msgid "f_floor - Round Fractions Down"
msgstr "f_floor - Kesirleri Aşağı Yuvarlama"

#: include/global_arrays.php:289 include/global_arrays.php:355
#: lib/const_measurands.php:131 lib/const_measurands.php:171
msgid "Returns the next lowest integer value by rounding down value if necessary."
msgstr "Gerekirse değeri aşağı yuvarlayarak bir sonraki en küçük tamsayı değerini döndürür."

#: include/global_arrays.php:290 include/global_arrays.php:298
#: include/global_arrays.php:356 lib/const_measurands.php:132
#: lib/const_measurands.php:172 lib/const_measurands.php:179
msgid "$var: float"
msgstr "$var: Şamandıra"

#: include/global_arrays.php:296 lib/const_measurands.php:177
msgid "f_ceil - Round Fractions Up"
msgstr "f_ceil - Kesirleri Yukarı Yuvarlama"

#: include/global_arrays.php:297 lib/const_measurands.php:178
msgid "Returns the next highest integer value by rounding up value if necessary."
msgstr "Gerekirse, değeri yukarı yuvarlayarak bir sonraki en yüksek tamsayı değerini döndürür."

#: include/global_arrays.php:304 lib/const_measurands.php:184
msgid "f_round - Round A Float"
msgstr "f_round - Yuvarlak Bir Şamandıra"

#: include/global_arrays.php:305 include/global_arrays.php:363
#: lib/const_measurands.php:138 lib/const_measurands.php:185
msgid "Returns the rounded integer value of any given float."
msgstr "Belirli bir float'ın yuvarlanmış tamsayı değerini döndürür."

#: include/global_arrays.php:306 include/global_arrays.php:364
#: lib/const_measurands.php:139 lib/const_measurands.php:186
msgid "$var: float or string value"
msgstr "$var: float veya dize değeri"

#: include/global_arrays.php:312 lib/const_measurands.php:191
msgid "f_high - Find Highest Value"
msgstr "f_high - En Yüksek Değeri Bul"

#: include/global_arrays.php:313 lib/const_measurands.php:192
msgid "Returns the highest value of a given list of parameters"
msgstr "Belirli bir parametre listesinin en yüksek değerini döndürür"

#: include/global_arrays.php:314 include/global_arrays.php:322
#: lib/const_measurands.php:193 lib/const_measurands.php:200
