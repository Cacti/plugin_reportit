#~ msgid "Administration"
#~ msgstr "Amministrazione"

#~ msgid "Scheduled Reporting"
#~ msgstr "Reportistica programmata"

#~ msgid "Frequency"
#~ msgstr "Frequenza"

#~ msgid "Select the frequency for processing this Report. ReportIt has a basic scheduler that will dispatch reports at midnight each day based upon the dispatch frequency specified by the user."
#~ msgstr "Selezionare la frequenza di elaborazione del report. ReportIt dispone di uno scheduler di base che invierà i report a mezzanotte di ogni giorno in base alla frequenza di invio specificata dall'utente."

#~ msgid "Auto Generated Archive"
#~ msgstr "Archivio generato automaticamente"

#~ msgid "Define the maximum number of instances which should be archived before the first one will be overwritten.  Choose \"off\" if you want to deactivate that RoundRobbin principle (default, but not recommend).  If you define a lower value of instances than the current archive contains then it will get shrunk automatically within the next run."
#~ msgstr "Definire il numero massimo di istanze che devono essere archiviate prima che la prima venga sovrascritta.  Scegliere \"off\" se si desidera disattivare il principio RoundRobbin (impostazione predefinita, ma non consigliabile).  Se si definisce un valore di istanze inferiore a quello contenuto nell'archivio corrente, verrà compattato automaticamente entro l'esecuzione successiva."

#~ msgid "Auto Generated Export"
#~ msgstr "Esportazione generata automaticamente"

#~ msgid "If enabled the report will be automatically exported to a separate subfolder.  This will be placed within the export folder defined in the report template."
#~ msgstr "Se abilitato, il report verrà automaticamente esportato in una sottocartella separata.  Questo verrà inserito all'interno della cartella di esportazione definita nel modello di report."

#~ msgid "Export Limitation"
#~ msgstr "Limitazione dell'esportazione"

#~ msgid "Define the maximum number of instances which should be archived before the first one will be overwritten.  Choose 'off' if you want to deactivate that RoundRobbin principle (default, but not recommend).  If you define a lower value of instances than the current export folder contains then it will get shrunk automatically within the next run."
#~ msgstr "Definire il numero massimo di istanze che devono essere archiviate prima che la prima venga sovrascritta.  Scegliere \"off\" se si desidera disattivare il principio RoundRobbin (impostazione predefinita, ma non consigliabile).  Se si definisce un valore di istanze inferiore a quello contenuto nella cartella di esportazione corrente, verrà compattato automaticamente entro l'esecuzione successiva."

#~ msgid "Raw Data Export"
#~ msgstr "Esportazione di dati grezzi"

#~ msgid "If enabled auto generated exports will contain raw data only. The formatting of measurands will be ignored."
#~ msgstr "Se abilitato, le esportazioni generate automaticamente conterranno solo dati non elaborati. La formattazione dei misurandi verrà ignorata."

#~ msgid "Change Report Owner"
#~ msgstr "Modifica proprietario del rapporto"

#~ msgid "Change the owner of this report. Only users with a minimum of reporting rights ('View' or higher) can be selected."
#~ msgstr "Modificare il proprietario del report. È possibile selezionare solo gli utenti con un minimo di diritti di segnalazione (\"Visualizza\" o superiore)."

